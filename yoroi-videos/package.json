{
  "name": "yoroi-videos",
  "version": "1.0.0",
  "description": "YOROI TikTok & Instagram Videos",
  "scripts": {
    "start": "remotion studio",
    "render:trailer": "remotion render YoroiTrailer out/trailer.mp4",
    "render:features": "remotion render YoroiFeatures out/features.mp4",
    "render:all": "remotion render YoroiTrailer out/trailer.mp4 && remotion render YoroiFeatures out/features.mp4"
  },
  "dependencies": {
    "@remotion/cli": "4.0.290",
    "remotion": "4.0.290"
  },
  "remotion": {
    "entryPoint": "src/index.tsx"
  }
}
