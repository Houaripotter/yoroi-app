/* YOROI : textes système en ru. Source : Info.plist (français). */
"CFBundleDisplayName" = "Yoroi";
"NSCalendarsFullAccessUsageDescription" = "YOROI добавляет соревнования в твой календарь, когда ты просишь, например твой следующий турнир с напоминанием накануне. Событие сохраняется только после твоего подтверждения.";
"NSCalendarsUsageDescription" = "YOROI добавляет соревнования в твой календарь, когда ты просишь, например твой следующий турнир с напоминанием накануне. Событие сохраняется только после твоего подтверждения.";
"NSCameraUsageDescription" = "YOROI использует камеру только по твоему выбору: фото профиля, фото прогресса, фото для карточки, логотип твоего клуба или видео техники для дневника. Например, фото анфас каждый месяц, чтобы видеть, как меняется твоя форма. Ничего не отправляется на сервер YOROI.";
"NSFaceIDUsageDescription" = "YOROI использует Face ID, только если ты включишь блокировку приложения, чтобы никто другой не открыл твой дневник и твои взвешивания.";
"NSHealthShareUsageDescription" = "YOROI читает в Apple Health твой вес и состав тела, активность, сердце, сон, тренировки (маршруты, нагрузку, шаг, мощность, зоны) и то, что ты пьёшь и ешь, чтобы показывать твой прогресс и готовность на сегодня. Расширенные показатели (ходьба, оповещения о сердце, звуки, нутриенты) только если ты их включишь. Ничего не отправляется на сервер YOROI.";
"NSHealthUpdateUsageDescription" = "YOROI записывает в Apple Health твои взвешивания и процент жира, тренировки, которые ты отмечаешь, воду и сон, которые ты вводишь вручную. Ничего не отправляется на сервер YOROI.";
"NSLocalNetworkUsageDescription" = "YOROI использует локальную сеть, чтобы синхронизировать твои данные напрямую между устройствами, связанными по коду (iPhone, iPad, Mac), когда приложение открыто. Ничего не идёт через интернет или сервер YOROI.";
"NSLocationWhenInUseUsageDescription" = "YOROI использует твоё местоположение, только когда ты просишь об этом в тренировке, чтобы указать название места, например твой зал и город. Никогда в фоновом режиме, и ничего не отправляется на сервер YOROI.";
"NSMicrophoneUsageDescription" = "YOROI использует микрофон для звука видео, которые ты снимаешь в дневнике тренировок, и для голосовых заметок в карточке партнёра по спаррингу. Например, снять технику с объяснениями твоего тренера. Ничего не отправляется на сервер YOROI.";
"NSPhotoLibraryAddUsageDescription" = "YOROI сохраняет в твою медиатеку карточки, которые ты создаёшь, только когда ты просишь. Например, карточку рекорда или сравнение до и после. Ничего не отправляется на сервер YOROI.";
"NSPhotoLibraryUsageDescription" = "YOROI открывает твою медиатеку, только когда ты выбираешь фото или видео: фото профиля, фото прогресса, фото твоих весов, видео для дневника, фото партнёра или логотип твоего клуба. Например, импортировать видео твоего последнего спарринга. Ничего не отправляется на сервер YOROI.";
"NSRemindersFullAccessUsageDescription" = "YOROI не читает и не создаёт напоминания в приложении «Напоминания» и не запрашивает этот доступ. Твои напоминания, например о времени сна, приходят как уведомления YOROI.";
"NSRemindersUsageDescription" = "YOROI не читает и не создаёт напоминания в приложении «Напоминания» и не запрашивает этот доступ. Твои напоминания, например о времени сна, приходят как уведомления YOROI.";
