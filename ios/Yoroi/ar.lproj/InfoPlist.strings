"CFBundleDisplayName" = "Yoroi";
"NSCalendarsFullAccessUsageDescription" = "يضيف YOROI منافسة إلى تقويمك عند طلبك، مثل بطولتك القادمة مع تذكير في اليوم السابق. أنت من يؤكد الحدث قبل حفظه.";
"NSCalendarsUsageDescription" = "يضيف YOROI منافسة إلى تقويمك عند طلبك، مثل بطولتك القادمة مع تذكير في اليوم السابق. أنت من يؤكد الحدث قبل حفظه.";
"NSCameraUsageDescription" = "يستخدم YOROI الكاميرا فقط باختيارك: صورة ملفك الشخصي، وصور تقدمك، وصورة بطاقة مشاركة، وشعار ناديك، أو فيديو تقنية ليومياتك. مثلًا، صورة أمامية كل شهر لمتابعة تطور قوامك. لا يرسل أي شيء إلى خادم YOROI.";
"NSFaceIDUsageDescription" = "يستخدم YOROI ميزة Face ID فقط إذا فعّلت قفل التطبيق، حتى لا يفتح أحد غيرك يومياتك وقياسات وزنك.";
"NSHealthShareUsageDescription" = "يقرأ YOROI من تطبيق الصحة من Apple وزنك وتكوين جسمك، ونشاطك، وقلبك، ونومك، وحصصك (المسارات، والجهد، والخطوة، والقدرة، والنطاقات) وما تشربه وتأكله، لعرض تقدمك وجاهزيتك لليوم. القياسات المتقدمة (المشي، وتنبيهات القلب، والأصوات، والمغذيات) فقط إذا فعّلتها. لا يرسل أي شيء إلى خادم YOROI.";
"NSHealthUpdateUsageDescription" = "يحفظ YOROI في تطبيق الصحة من Apple قياسات وزنك ونسبة الدهون، والحصص التي تسجلها، واستهلاكك من الماء، والنوم الذي تدخله يدويًا. لا يرسل أي شيء إلى خادم YOROI.";
"NSLocalNetworkUsageDescription" = "يستخدم YOROI الشبكة المحلية لمزامنة بياناتك مباشرة بين أجهزتك المقترنة برمز (iPhone، iPad، Mac)، عندما يكون التطبيق مفتوحًا. لا يمر أي شيء عبر الإنترنت ولا عبر خادم YOROI.";
"NSLocationWhenInUseUsageDescription" = "يستخدم YOROI موقعك فقط عندما تطلبه في حصة، لتسجيل اسم المكان، مثل صالتك ومدينتك. لا يعمل أبدًا في الخلفية، ولا يرسل أي شيء إلى خادم YOROI.";
"NSMicrophoneUsageDescription" = "يستخدم YOROI الميكروفون لصوت الفيديوهات التي تصورها في يوميات تدريبك وللملاحظات الصوتية في بطاقة شريك السبارينغ. مثلًا، تصوير تقنية مع شروحات مدربك. لا يرسل أي شيء إلى خادم YOROI.";
"NSPhotoLibraryAddUsageDescription" = "يحفظ YOROI في مكتبة صورك بطاقات المشاركة التي تنشئها، فقط عند طلبك. مثلًا، بطاقة رقمك القياسي أو مقارنة قبل وبعد. لا يرسل أي شيء إلى خادم YOROI.";
"NSPhotoLibraryUsageDescription" = "يفتح YOROI مكتبة صورك فقط عندما تختار صورة أو فيديو: صورة ملفك الشخصي، وصور تقدمك، وصور ميزانك، وفيديو ليومياتك، وصور شريك، أو شعار ناديك. مثلًا، استيراد فيديو آخر سبارينغ لك. لا يرسل أي شيء إلى خادم YOROI.";
"NSRemindersFullAccessUsageDescription" = "لا يقرأ YOROI التذكيرات في تطبيق التذكيرات ولا ينشئها، ولا يطلب منك هذا الوصول. تصلك تذكيراتك، مثل تذكير موعد النوم، كإشعارات من YOROI.";
"NSRemindersUsageDescription" = "لا يقرأ YOROI التذكيرات في تطبيق التذكيرات ولا ينشئها، ولا يطلب منك هذا الوصول. تصلك تذكيراتك، مثل تذكير موعد النوم، كإشعارات من YOROI.";
