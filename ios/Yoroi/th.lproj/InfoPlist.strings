/* YOROI : textes système en th. Source : Info.plist (français). */
"CFBundleDisplayName" = "Yoroi";
"NSCalendarsFullAccessUsageDescription" = "YOROI เพิ่มการแข่งขันลงในปฏิทินเมื่อคุณขอ เช่น ทัวร์นาเมนต์ครั้งถัดไปพร้อมการเตือนล่วงหน้า 1 วัน คุณยืนยันกิจกรรมด้วยตัวเองก่อนที่จะบันทึก";
"NSCalendarsUsageDescription" = "YOROI เพิ่มการแข่งขันลงในปฏิทินเมื่อคุณขอ เช่น ทัวร์นาเมนต์ครั้งถัดไปพร้อมการเตือนล่วงหน้า 1 วัน คุณยืนยันกิจกรรมด้วยตัวเองก่อนที่จะบันทึก";
"NSCameraUsageDescription" = "YOROI ใช้กล้องเฉพาะเมื่อคุณเลือกเท่านั้น: รูปโปรไฟล์, รูปความก้าวหน้า, รูปสำหรับการ์ดแชร์, โลโก้ยิมของคุณ หรือวิดีโอเทคนิคสำหรับสมุดบันทึก เช่น ถ่ายรูปด้านหน้าทุกเดือนเพื่อดูรูปร่างที่เปลี่ยนไป ไม่มีอะไรถูกส่งไปยังเซิร์ฟเวอร์ของ YOROI";
"NSFaceIDUsageDescription" = "YOROI ใช้ Face ID เฉพาะเมื่อคุณเปิดการล็อกแอป เพื่อไม่ให้คนอื่นเปิดสมุดบันทึกและการชั่งน้ำหนักของคุณได้";
"NSHealthShareUsageDescription" = "YOROI อ่านข้อมูลจาก Apple Health ได้แก่ น้ำหนักและองค์ประกอบร่างกาย กิจกรรม หัวใจ การนอน เซสชัน (เส้นทาง ความหนัก รอบก้าว กำลัง โซน) และสิ่งที่คุณดื่มและกิน เพื่อแสดงความก้าวหน้าและความพร้อมของวันนี้ ค่าวัดขั้นสูง (การเดิน การแจ้งเตือนหัวใจ ระดับเสียง สารอาหาร) จะอ่านเฉพาะเมื่อคุณเปิดใช้ ไม่มีอะไรถูกส่งไปยังเซิร์ฟเวอร์ของ YOROI";
"NSHealthUpdateUsageDescription" = "YOROI บันทึกลงใน Apple Health ได้แก่ การชั่งน้ำหนักและไขมันในร่างกาย เซสชันที่คุณบันทึก การดื่มน้ำ และการนอนที่คุณกรอกเอง ไม่มีอะไรถูกส่งไปยังเซิร์ฟเวอร์ของ YOROI";
"NSLocalNetworkUsageDescription" = "YOROI ใช้เครือข่ายภายในเพื่อซิงค์ข้อมูลโดยตรงระหว่างอุปกรณ์ที่จับคู่ด้วยรหัส (iPhone, iPad, Mac) ขณะเปิดแอป ไม่มีอะไรผ่านอินเทอร์เน็ตหรือเซิร์ฟเวอร์ของ YOROI";
"NSLocationWhenInUseUsageDescription" = "YOROI ใช้ตำแหน่งของคุณเฉพาะเมื่อคุณขอในเซสชัน เพื่อใส่ชื่อสถานที่ เช่น ยิมและเมืองของคุณ ไม่ใช้ในเบื้องหลังเลย และไม่มีอะไรถูกส่งไปยังเซิร์ฟเวอร์ของ YOROI";
"NSMicrophoneUsageDescription" = "YOROI ใช้ไมโครโฟนสำหรับเสียงของวิดีโอที่คุณถ่ายในสมุดบันทึกการฝึก และสำหรับโน้ตเสียงในโปรไฟล์คู่สปาร์ริ่ง เช่น ถ่ายวิดีโอเทคนิคพร้อมคำอธิบายของโค้ช ไม่มีอะไรถูกส่งไปยังเซิร์ฟเวอร์ของ YOROI";
"NSPhotoLibraryAddUsageDescription" = "YOROI บันทึกการ์ดแชร์ที่คุณสร้างลงในคลังรูปภาพ เฉพาะเมื่อคุณขอเท่านั้น เช่น การ์ดสถิติส่วนตัว หรือภาพเปรียบเทียบก่อนและหลัง ไม่มีอะไรถูกส่งไปยังเซิร์ฟเวอร์ของ YOROI";
"NSPhotoLibraryUsageDescription" = "YOROI เปิดคลังรูปภาพเฉพาะเมื่อคุณเลือกรูปหรือวิดีโอ: รูปโปรไฟล์, รูปความก้าวหน้า, รูปเครื่องชั่ง, วิดีโอสำหรับสมุดบันทึก, รูปของคู่ซ้อม หรือโลโก้ยิมของคุณ เช่น นำเข้าวิดีโอสปาร์ริ่งครั้งล่าสุด ไม่มีอะไรถูกส่งไปยังเซิร์ฟเวอร์ของ YOROI";
"NSRemindersFullAccessUsageDescription" = "YOROI ไม่อ่านและไม่สร้างการเตือนในแอปเตือนความจำ และไม่ขอสิทธิ์นี้จากคุณ การเตือนของคุณ เช่น การเตือนเข้านอน จะมาเป็นการแจ้งเตือนของ YOROI";
"NSRemindersUsageDescription" = "YOROI ไม่อ่านและไม่สร้างการเตือนในแอปเตือนความจำ และไม่ขอสิทธิ์นี้จากคุณ การเตือนของคุณ เช่น การเตือนเข้านอน จะมาเป็นการแจ้งเตือนของ YOROI";
