/* YOROI : textes système en tr. Source : Info.plist (français). */
"CFBundleDisplayName" = "Yoroi";
"NSCalendarsFullAccessUsageDescription" = "YOROI, istediğinde takvimine bir müsabaka ekler, örneğin bir gün önceden hatırlatıcıyla bir sonraki turnuvanı. Etkinlik kaydedilmeden önce onu kendin onaylarsın.";
"NSCalendarsUsageDescription" = "YOROI, istediğinde takvimine bir müsabaka ekler, örneğin bir gün önceden hatırlatıcıyla bir sonraki turnuvanı. Etkinlik kaydedilmeden önce onu kendin onaylarsın.";
"NSCameraUsageDescription" = "YOROI kamerayı yalnızca sen seçtiğinde kullanır: profil fotoğrafın, ilerleme fotoğrafların, bir paylaşım kartının fotoğrafı, kulübünün logosu ya da günlüğün için bir teknik videosu. Örneğin formunun nasıl değiştiğini görmek için her ay önden bir fotoğraf. Hiçbir şey YOROI sunucusuna gönderilmez.";
"NSFaceIDUsageDescription" = "YOROI, Face ID'yi yalnızca uygulama kilidini etkinleştirirsen kullanır; böylece günlüğünü ve tartılarını senden başkası açamaz.";
"NSHealthShareUsageDescription" = "YOROI, ilerlemeni ve günlük hazırlık durumunu göstermek için Apple Sağlık'tan kilonu ve vücut kompozisyonunu, aktiviteni, kalbini, uykunu, antrenmanlarını (rotalar, efor, adım, güç, bölgeler) ve ne içip ne yediğini okur. Gelişmiş ölçümler (yürüme, kalp uyarıları, sesler, besin öğeleri) yalnızca sen etkinleştirirsen. Hiçbir şey YOROI sunucusuna gönderilmez.";
"NSHealthUpdateUsageDescription" = "YOROI, tartılarını ve yağ oranını, kaydettiğin antrenmanları, içtiğin suyu ve elle girdiğin uykuyu Apple Sağlık'a kaydeder. Hiçbir şey YOROI sunucusuna gönderilmez.";
"NSLocalNetworkUsageDescription" = "YOROI, uygulama açıkken verilerini kodla eşleştirilmiş cihazların (iPhone, iPad, Mac) arasında doğrudan senkronize etmek için yerel ağı kullanır. Hiçbir şey internetten ya da YOROI sunucusundan geçmez.";
"NSLocationWhenInUseUsageDescription" = "YOROI konumunu yalnızca bir antrenmanda sen istediğinde, yerin adını eklemek için kullanır; örneğin salonun ve şehrin. Asla arka planda değil ve hiçbir şey YOROI sunucusuna gönderilmez.";
"NSMicrophoneUsageDescription" = "YOROI mikrofonu, antrenman günlüğünde çektiğin videoların sesi ve bir sparring partnerinin profilindeki sesli notlar için kullanır. Örneğin bir tekniği koçunun açıklamalarıyla birlikte çekmek. Hiçbir şey YOROI sunucusuna gönderilmez.";
"NSPhotoLibraryAddUsageDescription" = "YOROI, oluşturduğun paylaşım kartlarını yalnızca sen istediğinde fotoğraf arşivine kaydeder. Örneğin rekor kartını ya da önce ve sonra karşılaştırmanı. Hiçbir şey YOROI sunucusuna gönderilmez.";
"NSPhotoLibraryUsageDescription" = "YOROI fotoğraf arşivini yalnızca bir görsel ya da video seçtiğinde açar: profil fotoğrafın, ilerleme fotoğrafların, baskülünün fotoğrafları, günlüğün için bir video, bir partnerinin fotoğrafları ya da kulübünün logosu. Örneğin son sparring'inin videosunu içe aktarmak. Hiçbir şey YOROI sunucusuna gönderilmez.";
"NSRemindersFullAccessUsageDescription" = "YOROI, Anımsatıcılar uygulamandaki anımsatıcıları okumaz, yenisini de oluşturmaz ve senden bu erişimi istemez. Hatırlatıcıların, örneğin yatma saati hatırlatıcısı, YOROI bildirimi olarak gelir.";
"NSRemindersUsageDescription" = "YOROI, Anımsatıcılar uygulamandaki anımsatıcıları okumaz, yenisini de oluşturmaz ve senden bu erişimi istemez. Hatırlatıcıların, örneğin yatma saati hatırlatıcısı, YOROI bildirimi olarak gelir.";
