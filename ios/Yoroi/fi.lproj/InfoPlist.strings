/* YOROI : textes système en fi. Source : Info.plist (français). */
"CFBundleDisplayName" = "Yoroi";
"NSCalendarsFullAccessUsageDescription" = "YOROI lisää kilpailun kalenteriisi, kun pyydät, esimerkiksi seuraavan turnauksesi ja muistutuksen edellisenä päivänä. Hyväksyt tapahtuman itse ennen kuin se tallennetaan.";
"NSCalendarsUsageDescription" = "YOROI lisää kilpailun kalenteriisi, kun pyydät, esimerkiksi seuraavan turnauksesi ja muistutuksen edellisenä päivänä. Hyväksyt tapahtuman itse ennen kuin se tallennetaan.";
"NSCameraUsageDescription" = "YOROI käyttää kameraa vain, kun itse valitset: profiilikuvasi, kehityskuvasi, jakokortin kuva, seurasi logo tai tekniikkavideo päiväkirjaasi. Esimerkiksi kuva edestä joka kuukausi, jotta näet kuntosi kehityksen. Mitään ei lähetetä YOROI:n palvelimelle.";
"NSFaceIDUsageDescription" = "YOROI käyttää Face ID:tä vain, jos otat sovelluksen lukituksen käyttöön, jotta kukaan muu ei avaa päiväkirjaasi ja punnituksiasi.";
"NSHealthShareUsageDescription" = "YOROI lukee Applen Terveydestä painosi ja kehonkoostumuksesi, aktiivisuutesi, sydämesi, unesi, treenisi (reitit, rasitus, askellus, teho, alueet) sekä sen, mitä juot ja syöt, näyttääkseen kehityksesi ja päivän valmiutesi. Edistyneet mittaukset (kävely, sydänhälytykset, äänet, ravintoaineet) vain, jos otat ne käyttöön. Mitään ei lähetetä YOROI:n palvelimelle.";
"NSHealthUpdateUsageDescription" = "YOROI tallentaa Applen Terveyteen punnituksesi ja rasvaprosenttisi, kirjaamasi treenit, juomasi veden ja käsin syöttämäsi unen. Mitään ei lähetetä YOROI:n palvelimelle.";
"NSLocalNetworkUsageDescription" = "YOROI käyttää paikallisverkkoa synkronoidakseen tietosi suoraan koodilla yhdistettyjen laitteidesi välillä (iPhone, iPad, Mac), kun sovellus on auki. Mikään ei kulje internetin eikä YOROI:n palvelimen kautta.";
"NSLocationWhenInUseUsageDescription" = "YOROI käyttää sijaintiasi vain, kun pyydät sitä treenissä, lisätäkseen paikan nimen, esimerkiksi salisi ja kaupunkisi. Ei koskaan taustalla, eikä mitään lähetetä YOROI:n palvelimelle.";
"NSMicrophoneUsageDescription" = "YOROI käyttää mikrofonia treenipäiväkirjaasi kuvaamiesi videoiden ääneen ja sparrikaverin kortin ääniviesteihin. Esimerkiksi tekniikan kuvaamiseen valmentajasi selitysten kanssa. Mitään ei lähetetä YOROI:n palvelimelle.";
"NSPhotoLibraryAddUsageDescription" = "YOROI tallentaa luomasi jakokortit kuvakirjastoosi vain, kun pyydät. Esimerkiksi ennätyskorttisi tai ennen ja jälkeen -vertailusi. Mitään ei lähetetä YOROI:n palvelimelle.";
"NSPhotoLibraryUsageDescription" = "YOROI avaa kuvakirjastosi vain, kun valitset kuvan tai videon: profiilikuvasi, kehityskuvasi, vaakasi kuvat, videon päiväkirjaasi, treenikaverin kuvat tai seurasi logon. Esimerkiksi viimeisimmän sparrisi videon tuonti. Mitään ei lähetetä YOROI:n palvelimelle.";
"NSRemindersFullAccessUsageDescription" = "YOROI ei lue eikä luo muistutuksia Muistutukset-sovellukseesi, eikä pyydä sinulta tätä käyttöoikeutta. Muistutuksesi, esimerkiksi nukkumaanmenon muistutus, tulevat YOROI-ilmoituksina.";
"NSRemindersUsageDescription" = "YOROI ei lue eikä luo muistutuksia Muistutukset-sovellukseesi, eikä pyydä sinulta tätä käyttöoikeutta. Muistutuksesi, esimerkiksi nukkumaanmenon muistutus, tulevat YOROI-ilmoituksina.";
