/* YOROI : textes système en pt-BR. Source : Info.plist (français). */
"NSCalendarsFullAccessUsageDescription" = "O YOROI adiciona uma competição ao seu calendário quando você pede, por exemplo o seu próximo campeonato com um lembrete na véspera. Você mesmo confirma o evento antes de ele ser salvo.";
"NSCalendarsUsageDescription" = "O YOROI adiciona uma competição ao seu calendário quando você pede, por exemplo o seu próximo campeonato com um lembrete na véspera. Você mesmo confirma o evento antes de ele ser salvo.";
"NSCameraUsageDescription" = "O YOROI usa a câmera só quando você escolhe: sua foto de perfil, suas fotos de progresso, a foto de um cartão para compartilhar, o logo da sua academia ou um vídeo de técnica para o seu diário. Por exemplo, uma foto de frente todo mês para ver a sua forma evoluir. Nada é enviado a um servidor do YOROI.";
"NSFaceIDUsageDescription" = "O YOROI usa o Face ID só se você ativar o bloqueio do app, para que ninguém mais abra o seu diário e as suas pesagens.";
"NSHealthShareUsageDescription" = "O YOROI lê no app Saúde o seu peso e a sua composição corporal, a sua atividade, o seu coração, o seu sono, os seus treinos (trajetos, esforço, passada, potência, zonas) e o que você bebe e come, para mostrar o seu progresso e a sua prontidão do dia. As medições avançadas (marcha, alertas do coração, sons, nutrientes) só se você ativar. Nada é enviado a um servidor do YOROI.";
"NSHealthUpdateUsageDescription" = "O YOROI salva no app Saúde as suas pesagens e a sua gordura corporal, os treinos que você registra, a sua água e o sono que você insere manualmente. Nada é enviado a um servidor do YOROI.";
"NSLocalNetworkUsageDescription" = "O YOROI usa a rede local para sincronizar os seus dados com o seu iPad pareado por código, só quando a tela de sincronização está aberta.";
"NSLocationWhenInUseUsageDescription" = "O YOROI usa a sua localização só quando você pede em um treino, para registrar o nome do lugar, por exemplo a sua academia e a sua cidade. Nunca em segundo plano, e nada é enviado a um servidor do YOROI.";
"NSMicrophoneUsageDescription" = "O YOROI usa o microfone para o som dos vídeos que você grava no seu diário de treino e para as notas de voz da ficha de um parceiro de sparring. Por exemplo, gravar uma técnica com as explicações do seu professor. Nada é enviado a um servidor do YOROI.";
"NSPhotoLibraryAddUsageDescription" = "O YOROI salva na sua fototeca os cartões para compartilhar que você cria, só quando você pede. Por exemplo, o seu cartão de recorde ou a sua comparação antes e depois. Nada é enviado a um servidor do YOROI.";
"NSPhotoLibraryUsageDescription" = "O YOROI abre a sua fototeca só quando você escolhe uma imagem ou um vídeo: sua foto de perfil, suas fotos de progresso, as fotos da sua balança, um vídeo para o seu diário, as fotos de um parceiro ou o logo da sua academia. Por exemplo, importar o vídeo do seu último sparring. Nada é enviado a um servidor do YOROI.";
"NSRemindersFullAccessUsageDescription" = "O YOROI não lê nem cria lembretes no seu app Lembretes, e não pede esse acesso. Seus lembretes, por exemplo o da hora de dormir, chegam como notificações do YOROI.";
"NSRemindersUsageDescription" = "O YOROI não lê nem cria lembretes no seu app Lembretes, e não pede esse acesso. Seus lembretes, por exemplo o da hora de dormir, chegam como notificações do YOROI.";
"CFBundleDisplayName" = "Yoroi";
