/* YOROI : textes système en ms. Source : Info.plist (français). */
"CFBundleDisplayName" = "Yoroi";
"NSCalendarsFullAccessUsageDescription" = "YOROI menambah pertandingan ke kalendar anda apabila anda memintanya, contohnya kejohanan anda yang seterusnya dengan peringatan sehari sebelumnya. Anda sendiri mengesahkan acara itu sebelum ia disimpan.";
"NSCalendarsUsageDescription" = "YOROI menambah pertandingan ke kalendar anda apabila anda memintanya, contohnya kejohanan anda yang seterusnya dengan peringatan sehari sebelumnya. Anda sendiri mengesahkan acara itu sebelum ia disimpan.";
"NSCameraUsageDescription" = "YOROI menggunakan kamera hanya apabila anda memilihnya: foto profil anda, foto kemajuan anda, foto kad perkongsian, logo kelab anda atau video teknik untuk jurnal anda. Contohnya, foto dari depan setiap bulan untuk melihat perubahan bentuk badan anda. Tiada apa-apa dihantar ke pelayan YOROI.";
"NSFaceIDUsageDescription" = "YOROI menggunakan Face ID hanya jika anda mengaktifkan kunci aplikasi, supaya tiada orang lain dapat membuka jurnal dan penimbangan anda.";
"NSHealthShareUsageDescription" = "YOROI membaca daripada Apple Health berat dan komposisi badan anda, aktiviti, jantung, tidur, sesi anda (laluan, usaha, langkah, kuasa, zon) serta apa yang anda minum dan makan, untuk memaparkan kemajuan dan kesediaan anda hari ini. Ukuran lanjutan (berjalan, amaran jantung, bunyi, nutrien) hanya jika anda mengaktifkannya. Tiada apa-apa dihantar ke pelayan YOROI.";
"NSHealthUpdateUsageDescription" = "YOROI menyimpan dalam Apple Health penimbangan dan lemak badan anda, sesi yang anda catat, air anda dan tidur yang anda masukkan secara manual. Tiada apa-apa dihantar ke pelayan YOROI.";
"NSLocalNetworkUsageDescription" = "YOROI menggunakan rangkaian setempat untuk menyegerakkan data anda terus antara peranti anda yang dipasangkan dengan kod (iPhone, iPad, Mac), apabila aplikasi dibuka. Tiada apa-apa melalui internet atau pelayan YOROI.";
"NSLocationWhenInUseUsageDescription" = "YOROI menggunakan lokasi anda hanya apabila anda memintanya dalam sesi, untuk mencatat nama tempat, contohnya gim dan bandar anda. Tidak sekali-kali di latar belakang, dan tiada apa-apa dihantar ke pelayan YOROI.";
"NSMicrophoneUsageDescription" = "YOROI menggunakan mikrofon untuk bunyi video yang anda rakam dalam jurnal latihan anda dan untuk nota suara pada profil rakan sparring. Contohnya, merakam teknik dengan penerangan jurulatih anda. Tiada apa-apa dihantar ke pelayan YOROI.";
"NSPhotoLibraryAddUsageDescription" = "YOROI menyimpan dalam pustaka foto anda kad perkongsian yang anda cipta, hanya apabila anda memintanya. Contohnya, kad rekod anda atau perbandingan sebelum dan selepas. Tiada apa-apa dihantar ke pelayan YOROI.";
"NSPhotoLibraryUsageDescription" = "YOROI membuka pustaka foto anda hanya apabila anda memilih imej atau video: foto profil anda, foto kemajuan anda, foto penimbang anda, video untuk jurnal anda, foto rakan latihan atau logo kelab anda. Contohnya, import video sparring terakhir anda. Tiada apa-apa dihantar ke pelayan YOROI.";
"NSRemindersFullAccessUsageDescription" = "YOROI tidak membaca dan tidak mencipta peringatan dalam aplikasi Peringatan anda, dan tidak meminta akses ini. Peringatan anda, contohnya peringatan waktu tidur, tiba sebagai pemberitahuan YOROI.";
"NSRemindersUsageDescription" = "YOROI tidak membaca dan tidak mencipta peringatan dalam aplikasi Peringatan anda, dan tidak meminta akses ini. Peringatan anda, contohnya peringatan waktu tidur, tiba sebagai pemberitahuan YOROI.";
