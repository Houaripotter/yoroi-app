/* YOROI : textes système en vi. Source : Info.plist (français). */
"CFBundleDisplayName" = "Yoroi";
"NSCalendarsFullAccessUsageDescription" = "YOROI thêm giải đấu vào lịch của bạn khi bạn yêu cầu, ví dụ giải đấu sắp tới của bạn kèm lời nhắc vào hôm trước. Bạn tự xác nhận sự kiện trước khi nó được lưu.";
"NSCalendarsUsageDescription" = "YOROI thêm giải đấu vào lịch của bạn khi bạn yêu cầu, ví dụ giải đấu sắp tới của bạn kèm lời nhắc vào hôm trước. Bạn tự xác nhận sự kiện trước khi nó được lưu.";
"NSCameraUsageDescription" = "YOROI chỉ dùng camera khi bạn chọn: ảnh hồ sơ, ảnh tiến bộ, ảnh cho thẻ chia sẻ, logo câu lạc bộ hoặc video kỹ thuật cho nhật ký của bạn. Ví dụ, mỗi tháng chụp một ảnh chính diện để thấy vóc dáng thay đổi. Không có gì được gửi đến máy chủ của YOROI.";
"NSFaceIDUsageDescription" = "YOROI chỉ dùng Face ID nếu bạn bật khóa ứng dụng, để không ai khác mở được nhật ký và các lần cân của bạn.";
"NSHealthShareUsageDescription" = "YOROI đọc từ Apple Sức khỏe cân nặng và thành phần cơ thể, hoạt động, tim, giấc ngủ, các buổi tập (lộ trình, cường độ, sải chân, công suất, vùng nhịp tim) và những gì bạn uống và ăn, để hiển thị tiến bộ và mức sẵn sàng hôm nay của bạn. Các chỉ số nâng cao (đi bộ, cảnh báo tim, âm thanh, dưỡng chất) chỉ khi bạn bật. Không có gì được gửi đến máy chủ của YOROI.";
"NSHealthUpdateUsageDescription" = "YOROI ghi vào Apple Sức khỏe các lần cân và tỷ lệ mỡ, các buổi tập bạn ghi lại, lượng nước uống và giấc ngủ bạn nhập thủ công. Không có gì được gửi đến máy chủ của YOROI.";
"NSLocalNetworkUsageDescription" = "YOROI dùng mạng cục bộ để đồng bộ dữ liệu trực tiếp giữa các thiết bị bạn đã ghép nối bằng mã (iPhone, iPad, Mac), khi ứng dụng đang mở. Không có gì đi qua internet hay máy chủ của YOROI.";
"NSLocationWhenInUseUsageDescription" = "YOROI chỉ dùng vị trí của bạn khi bạn yêu cầu trong một buổi tập, để ghi tên địa điểm, ví dụ phòng tập và thành phố của bạn. Không bao giờ chạy nền, và không có gì được gửi đến máy chủ của YOROI.";
"NSMicrophoneUsageDescription" = "YOROI dùng micro cho âm thanh của video bạn quay trong nhật ký tập luyện và cho ghi chú giọng nói trong hồ sơ bạn tập sparring. Ví dụ, quay một kỹ thuật kèm lời giải thích của huấn luyện viên. Không có gì được gửi đến máy chủ của YOROI.";
"NSPhotoLibraryAddUsageDescription" = "YOROI lưu vào thư viện ảnh các thẻ chia sẻ bạn tạo, chỉ khi bạn yêu cầu. Ví dụ, thẻ kỷ lục hoặc ảnh so sánh trước và sau của bạn. Không có gì được gửi đến máy chủ của YOROI.";
"NSPhotoLibraryUsageDescription" = "YOROI chỉ mở thư viện ảnh khi bạn chọn ảnh hoặc video: ảnh hồ sơ, ảnh tiến bộ, ảnh cân của bạn, video cho nhật ký, ảnh của bạn tập hoặc logo câu lạc bộ. Ví dụ, nhập video buổi sparring gần nhất của bạn. Không có gì được gửi đến máy chủ của YOROI.";
"NSRemindersFullAccessUsageDescription" = "YOROI không đọc và không tạo lời nhắc trong ứng dụng Lời nhắc của bạn, và không xin quyền truy cập này. Lời nhắc của bạn, ví dụ lời nhắc đi ngủ, đến dưới dạng thông báo YOROI.";
"NSRemindersUsageDescription" = "YOROI không đọc và không tạo lời nhắc trong ứng dụng Lời nhắc của bạn, và không xin quyền truy cập này. Lời nhắc của bạn, ví dụ lời nhắc đi ngủ, đến dưới dạng thông báo YOROI.";
