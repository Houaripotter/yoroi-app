/* YOROI : textes système en en. Source : Info.plist (français). */
"NSCalendarsFullAccessUsageDescription" = "YOROI adds a competition to your calendar when you ask, for example your next tournament with a reminder the day before. You confirm the event yourself before it is saved.";
"NSCalendarsUsageDescription" = "YOROI adds a competition to your calendar when you ask, for example your next tournament with a reminder the day before. You confirm the event yourself before it is saved.";
"NSCameraUsageDescription" = "YOROI uses the camera only when you choose to: your profile photo, your progress photos, a photo for a share card, your club logo or a technique video for your journal. For example, a front photo every month to see your shape change. Nothing is sent to a YOROI server.";
"NSFaceIDUsageDescription" = "YOROI uses Face ID only if you turn on the app lock, so nobody else can open your journal and your weigh-ins.";
"NSHealthShareUsageDescription" = "YOROI reads from Apple Health your weight and body composition, your activity, your heart, your sleep, your workouts (routes, effort, cadence, power, zones) and what you drink and eat, to show your progress and your readiness for the day. Advanced measurements (walking, heart alerts, sound levels, nutrients) only if you turn them on. Nothing is sent to a YOROI server.";
"NSHealthUpdateUsageDescription" = "YOROI saves to Apple Health your weigh-ins and body fat, the workouts you log, your water and the sleep you enter by hand. Nothing is sent to a YOROI server.";
"NSLocalNetworkUsageDescription" = "YOROI uses the local network to sync your data with the iPad you paired with a code, only while the sync screen is open.";
"NSLocationWhenInUseUsageDescription" = "YOROI uses your location only when you ask for it in a workout, to add the name of the place, for example your gym and your city. Never in the background, and nothing is sent to a YOROI server.";
"NSMicrophoneUsageDescription" = "YOROI uses the microphone for the sound of the videos you film in your training journal and for voice notes on a sparring partner's profile. For example, filming a technique with your coach's explanations. Nothing is sent to a YOROI server.";
"NSPhotoLibraryAddUsageDescription" = "YOROI saves the share cards you create to your photo library, only when you ask. For example, your PR card or your before and after comparison. Nothing is sent to a YOROI server.";
"NSPhotoLibraryUsageDescription" = "YOROI opens your photo library only when you pick an image or a video: your profile photo, your progress photos, photos of your scale, a video for your journal, a partner's photos or your club logo. For example, importing the video of your last sparring session. Nothing is sent to a YOROI server.";
"NSRemindersFullAccessUsageDescription" = "YOROI does not read or create reminders in your Reminders app, and does not ask you for this access. Your reminders, for example the bedtime one, arrive as YOROI notifications.";
"NSRemindersUsageDescription" = "YOROI does not read or create reminders in your Reminders app, and does not ask you for this access. Your reminders, for example the bedtime one, arrive as YOROI notifications.";
"CFBundleDisplayName" = "Yoroi";
