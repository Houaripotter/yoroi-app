/* YOROI : textes système en ko. Source : Info.plist (français). */
"CFBundleDisplayName" = "Yoroi";
"NSCalendarsFullAccessUsageDescription" = "YOROI는 요청할 때 대회를 캘린더에 추가해요. 예를 들어 다음 토너먼트를 전날 리마인더와 함께 추가할 수 있어요. 일정은 저장되기 전에 직접 확인해요.";
"NSCalendarsUsageDescription" = "YOROI는 요청할 때 대회를 캘린더에 추가해요. 예를 들어 다음 토너먼트를 전날 리마인더와 함께 추가할 수 있어요. 일정은 저장되기 전에 직접 확인해요.";
"NSCameraUsageDescription" = "YOROI는 직접 선택할 때만 카메라를 사용해요: 프로필 사진, 변화 사진, 공유 카드 사진, 클럽 로고, 훈련 일지용 기술 영상. 예를 들어 매달 정면 사진을 찍어 몸의 변화를 볼 수 있어요. YOROI 서버로는 아무것도 전송되지 않아요.";
"NSFaceIDUsageDescription" = "YOROI는 앱 잠금을 켠 경우에만 Face ID를 사용해요. 다른 사람이 일지와 체중 측정 기록을 열지 못하게 하기 위해서예요.";
"NSHealthShareUsageDescription" = "YOROI는 Apple 건강에서 체중과 체성분, 활동, 심장, 수면, 운동(경로, 강도, 케이던스, 파워, 영역), 마신 것과 먹은 것을 읽어 성장과 오늘의 컨디션을 보여 줘요. 고급 측정값(보행, 심장 알림, 소리, 영양소)은 직접 켠 경우에만 읽어요. YOROI 서버로는 아무것도 전송되지 않아요.";
"NSHealthUpdateUsageDescription" = "YOROI는 체중 측정과 체지방률, 기록한 세션, 수분 섭취, 직접 입력한 수면을 Apple 건강에 저장해요. YOROI 서버로는 아무것도 전송되지 않아요.";
"NSLocalNetworkUsageDescription" = "YOROI는 앱이 열려 있을 때 로컬 네트워크를 사용해 코드로 페어링한 기기(iPhone, iPad, Mac) 사이에서 데이터를 직접 동기화해요. 인터넷이나 YOROI 서버를 전혀 거치지 않아요.";
"NSLocationWhenInUseUsageDescription" = "YOROI는 세션에서 요청할 때만 위치를 사용해 장소 이름을 기록해요. 예를 들어 체육관과 도시 이름이에요. 백그라운드에서는 절대 사용하지 않고, YOROI 서버로는 아무것도 전송되지 않아요.";
"NSMicrophoneUsageDescription" = "YOROI는 훈련 일지에서 촬영하는 영상의 소리와 스파링 파트너 프로필의 음성 메모에 마이크를 사용해요. 예를 들어 코치의 설명과 함께 기술을 촬영할 수 있어요. YOROI 서버로는 아무것도 전송되지 않아요.";
"NSPhotoLibraryAddUsageDescription" = "YOROI는 요청할 때만 직접 만든 공유 카드를 사진 보관함에 저장해요. 예를 들어 개인 기록 카드나 비포 애프터 비교예요. YOROI 서버로는 아무것도 전송되지 않아요.";
"NSPhotoLibraryUsageDescription" = "YOROI는 이미지나 영상을 선택할 때만 사진 보관함을 열어요: 프로필 사진, 변화 사진, 체중계 사진, 일지용 영상, 파트너 사진, 클럽 로고. 예를 들어 마지막 스파링 영상을 가져올 수 있어요. YOROI 서버로는 아무것도 전송되지 않아요.";
"NSRemindersFullAccessUsageDescription" = "YOROI는 미리 알림 앱의 리마인더를 읽거나 만들지 않고, 이 접근 권한도 요청하지 않아요. 취침 리마인더 같은 리마인더는 YOROI 알림으로 받아요.";
"NSRemindersUsageDescription" = "YOROI는 미리 알림 앱의 리마인더를 읽거나 만들지 않고, 이 접근 권한도 요청하지 않아요. 취침 리마인더 같은 리마인더는 YOROI 알림으로 받아요.";
