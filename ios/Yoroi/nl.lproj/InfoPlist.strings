/* YOROI : textes système en nl. Source : Info.plist (français). */
"NSCalendarsFullAccessUsageDescription" = "YOROI zet een wedstrijd in je agenda wanneer je dat vraagt, bijvoorbeeld je volgende toernooi met een herinnering de dag ervoor. Je bevestigt het evenement zelf voordat het wordt opgeslagen.";
"NSCalendarsUsageDescription" = "YOROI zet een wedstrijd in je agenda wanneer je dat vraagt, bijvoorbeeld je volgende toernooi met een herinnering de dag ervoor. Je bevestigt het evenement zelf voordat het wordt opgeslagen.";
"NSCameraUsageDescription" = "YOROI gebruikt de camera alleen als jij dat kiest: je profielfoto, je voortgangsfoto's, een foto voor een deelkaart, het logo van je club of een techniekvideo voor je logboek. Bijvoorbeeld elke maand een foto van voren om te zien hoe je vorm verandert. Er wordt niets naar een server van YOROI gestuurd.";
"NSFaceIDUsageDescription" = "YOROI gebruikt Face ID alleen als je de appvergrendeling aanzet, zodat niemand anders je logboek en je wegingen kan openen.";
"NSHealthShareUsageDescription" = "YOROI leest in Apple Health je gewicht en lichaamssamenstelling, je activiteit, je hart, je slaap, je trainingen (routes, inspanning, cadans, vermogen, zones) en wat je drinkt en eet, om je voortgang en je dagvorm te tonen. Geavanceerde metingen (wandelen, hartmeldingen, geluidsniveaus, voedingsstoffen) alleen als je ze aanzet. Er wordt niets naar een server van YOROI gestuurd.";
"NSHealthUpdateUsageDescription" = "YOROI bewaart in Apple Health je wegingen en je vetpercentage, de trainingen die je noteert, je water en de slaap die je met de hand invoert. Er wordt niets naar een server van YOROI gestuurd.";
"NSLocalNetworkUsageDescription" = "YOROI gebruikt het lokale netwerk om je gegevens te synchroniseren met de iPad die je met een code hebt gekoppeld, alleen zolang het synchronisatiescherm open is.";
"NSLocationWhenInUseUsageDescription" = "YOROI gebruikt je locatie alleen als je erom vraagt in een training, om de naam van de plek toe te voegen, bijvoorbeeld je sportschool en je stad. Nooit op de achtergrond, en er wordt niets naar een server van YOROI gestuurd.";
"NSMicrophoneUsageDescription" = "YOROI gebruikt de microfoon voor het geluid van de video's die je filmt in je trainingslogboek en voor spraaknotities bij het profiel van een sparringpartner. Bijvoorbeeld een techniek filmen met de uitleg van je coach. Er wordt niets naar een server van YOROI gestuurd.";
"NSPhotoLibraryAddUsageDescription" = "YOROI bewaart de deelkaarten die je maakt in je fotobibliotheek, alleen als je dat vraagt. Bijvoorbeeld je recordkaart of je voor en na vergelijking. Er wordt niets naar een server van YOROI gestuurd.";
"NSPhotoLibraryUsageDescription" = "YOROI opent je fotobibliotheek alleen als je een afbeelding of video kiest: je profielfoto, je voortgangsfoto's, foto's van je weegschaal, een video voor je logboek, foto's van een partner of het logo van je club. Bijvoorbeeld de video van je laatste sparringsessie importeren. Er wordt niets naar een server van YOROI gestuurd.";
"NSRemindersFullAccessUsageDescription" = "YOROI leest of maakt geen herinneringen in je app Herinneringen, en vraagt je niet om deze toegang. Je herinneringen, bijvoorbeeld die voor het slapengaan, komen binnen als meldingen van YOROI.";
"NSRemindersUsageDescription" = "YOROI leest of maakt geen herinneringen in je app Herinneringen, en vraagt je niet om deze toegang. Je herinneringen, bijvoorbeeld die voor het slapengaan, komen binnen als meldingen van YOROI.";
"CFBundleDisplayName" = "Yoroi";
