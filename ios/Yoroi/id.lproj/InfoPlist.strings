/* YOROI : textes système en id. Source : Info.plist (français). */
"CFBundleDisplayName" = "Yoroi";
"NSCalendarsFullAccessUsageDescription" = "YOROI menambahkan kompetisi ke kalendermu saat kamu memintanya, misalnya turnamen berikutnya dengan pengingat sehari sebelumnya. Kamu sendiri yang mengonfirmasi acara itu sebelum disimpan.";
"NSCalendarsUsageDescription" = "YOROI menambahkan kompetisi ke kalendermu saat kamu memintanya, misalnya turnamen berikutnya dengan pengingat sehari sebelumnya. Kamu sendiri yang mengonfirmasi acara itu sebelum disimpan.";
"NSCameraUsageDescription" = "YOROI memakai kamera hanya saat kamu memilihnya: foto profilmu, foto progresmu, foto untuk kartu berbagi, logo klubmu, atau video teknik untuk catatan latihanmu. Misalnya, foto tampak depan setiap bulan untuk melihat perubahan bentuk tubuhmu. Tidak ada yang dikirim ke server YOROI.";
"NSFaceIDUsageDescription" = "YOROI memakai Face ID hanya jika kamu mengaktifkan kunci aplikasi, agar tidak ada orang lain yang bisa membuka catatan latihan dan penimbanganmu.";
"NSHealthShareUsageDescription" = "YOROI membaca dari app Kesehatan berat badan dan komposisi tubuhmu, aktivitasmu, jantungmu, tidurmu, sesimu (rute, upaya, langkah, daya, zona), serta apa yang kamu minum dan makan, untuk menampilkan progresmu dan kesiapanmu hari ini. Pengukuran lanjutan (berjalan, peringatan jantung, suara, nutrisi) hanya jika kamu mengaktifkannya. Tidak ada yang dikirim ke server YOROI.";
"NSHealthUpdateUsageDescription" = "YOROI menyimpan ke app Kesehatan penimbangan dan lemak tubuhmu, sesi yang kamu catat, asupan airmu, dan tidur yang kamu masukkan secara manual. Tidak ada yang dikirim ke server YOROI.";
"NSLocalNetworkUsageDescription" = "YOROI memakai jaringan lokal untuk menyinkronkan datamu langsung antara perangkatmu yang dipasangkan dengan kode (iPhone, iPad, Mac), saat aplikasi terbuka. Tidak ada yang lewat internet maupun server YOROI.";
"NSLocationWhenInUseUsageDescription" = "YOROI memakai lokasimu hanya saat kamu memintanya dalam sesi, untuk mencatat nama tempatnya, misalnya gym dan kotamu. Tidak pernah di latar belakang, dan tidak ada yang dikirim ke server YOROI.";
"NSMicrophoneUsageDescription" = "YOROI memakai mikrofon untuk suara video yang kamu rekam di catatan latihanmu dan untuk catatan suara di kartu partner sparring. Misalnya, merekam teknik dengan penjelasan coach-mu. Tidak ada yang dikirim ke server YOROI.";
"NSPhotoLibraryAddUsageDescription" = "YOROI menyimpan kartu berbagi yang kamu buat ke pustaka fotomu, hanya saat kamu memintanya. Misalnya, kartu PR-mu atau perbandingan sebelum dan sesudahmu. Tidak ada yang dikirim ke server YOROI.";
"NSPhotoLibraryUsageDescription" = "YOROI membuka pustaka fotomu hanya saat kamu memilih gambar atau video: foto profilmu, foto progresmu, foto timbanganmu, video untuk catatan latihanmu, foto partner, atau logo klubmu. Misalnya, mengimpor video sparring terakhirmu. Tidak ada yang dikirim ke server YOROI.";
"NSRemindersFullAccessUsageDescription" = "YOROI tidak membaca atau membuat pengingat di app Pengingat, dan tidak meminta akses ini. Pengingatmu, misalnya pengingat waktu tidur, datang sebagai notifikasi YOROI.";
"NSRemindersUsageDescription" = "YOROI tidak membaca atau membuat pengingat di app Pengingat, dan tidak meminta akses ini. Pengingatmu, misalnya pengingat waktu tidur, datang sebagai notifikasi YOROI.";
