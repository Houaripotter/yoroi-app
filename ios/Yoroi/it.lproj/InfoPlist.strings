/* YOROI : textes système en it. Source : Info.plist (français). */
"NSCalendarsFullAccessUsageDescription" = "YOROI aggiunge una gara al tuo calendario quando lo chiedi, per esempio il tuo prossimo torneo con un promemoria il giorno prima. Confermi tu l'evento prima che venga salvato.";
"NSCalendarsUsageDescription" = "YOROI aggiunge una gara al tuo calendario quando lo chiedi, per esempio il tuo prossimo torneo con un promemoria il giorno prima. Confermi tu l'evento prima che venga salvato.";
"NSCameraUsageDescription" = "YOROI usa la fotocamera solo quando lo scegli tu: la tua foto profilo, le tue foto dei progressi, la foto di una card da condividere, il logo del tuo club o un video di tecnica per il tuo diario. Per esempio, una foto frontale ogni mese per vedere come cambia la tua forma. Niente viene inviato a un server di YOROI.";
"NSFaceIDUsageDescription" = "YOROI usa Face ID solo se attivi il blocco dell'app, così nessun altro apre il tuo diario e le tue pesate.";
"NSHealthShareUsageDescription" = "YOROI legge nell'app Salute il tuo peso e la tua composizione corporea, la tua attività, il tuo cuore, il tuo sonno, le tue sessioni (percorsi, sforzo, falcata, potenza, zone) e quello che bevi e mangi, per mostrarti i progressi e la tua prontezza del giorno. Le misurazioni avanzate (camminata, avvisi del cuore, suoni, nutrienti) solo se le attivi. Niente viene inviato a un server di YOROI.";
"NSHealthUpdateUsageDescription" = "YOROI salva nell'app Salute le tue pesate e la tua massa grassa, le sessioni che registri, la tua acqua e il sonno che inserisci a mano. Niente viene inviato a un server di YOROI.";
"NSLocalNetworkUsageDescription" = "YOROI usa la rete locale per sincronizzare i tuoi dati con il tuo iPad abbinato tramite codice, solo quando la schermata di sincronizzazione è aperta.";
"NSLocationWhenInUseUsageDescription" = "YOROI usa la tua posizione solo quando la chiedi in una sessione, per annotare il nome del luogo, per esempio la tua palestra e la tua città. Mai in background, e niente viene inviato a un server di YOROI.";
"NSMicrophoneUsageDescription" = "YOROI usa il microfono per l'audio dei video che registri nel tuo diario di allenamento e per le note vocali della scheda di un compagno di sparring. Per esempio, filmare una tecnica con le spiegazioni del tuo coach. Niente viene inviato a un server di YOROI.";
"NSPhotoLibraryAddUsageDescription" = "YOROI salva nella tua libreria foto le card da condividere che crei, solo quando lo chiedi. Per esempio, la tua card del record o il tuo confronto prima e dopo. Niente viene inviato a un server di YOROI.";
"NSPhotoLibraryUsageDescription" = "YOROI apre la tua libreria foto solo quando scegli un'immagine o un video: la tua foto profilo, le tue foto dei progressi, le foto della tua bilancia, un video per il tuo diario, le foto di un compagno o il logo del tuo club. Per esempio, importare il video del tuo ultimo sparring. Niente viene inviato a un server di YOROI.";
"NSRemindersFullAccessUsageDescription" = "YOROI non legge e non crea promemoria nella tua app Promemoria, e non ti chiede questo accesso. I tuoi promemoria, per esempio quello per andare a dormire, arrivano come notifiche di YOROI.";
"NSRemindersUsageDescription" = "YOROI non legge e non crea promemoria nella tua app Promemoria, e non ti chiede questo accesso. I tuoi promemoria, per esempio quello per andare a dormire, arrivano come notifiche di YOROI.";
"CFBundleDisplayName" = "Yoroi";
