/* YOROI : textes système en pl. Source : Info.plist (français). */
"CFBundleDisplayName" = "Yoroi";
"NSCalendarsFullAccessUsageDescription" = "YOROI dodaje zawody do twojego kalendarza, kiedy o to poprosisz, na przykład najbliższy turniej z przypomnieniem dzień wcześniej. Wydarzenie zatwierdzasz samodzielnie, zanim zostanie zapisane.";
"NSCalendarsUsageDescription" = "YOROI dodaje zawody do twojego kalendarza, kiedy o to poprosisz, na przykład najbliższy turniej z przypomnieniem dzień wcześniej. Wydarzenie zatwierdzasz samodzielnie, zanim zostanie zapisane.";
"NSCameraUsageDescription" = "YOROI używa aparatu tylko wtedy, gdy tego chcesz: do zdjęcia profilowego, zdjęć postępów, zdjęcia na kartę do udostępnienia, logo twojego klubu lub filmu z techniką do dziennika. Na przykład zdjęcie z przodu co miesiąc, aby widzieć, jak zmienia się twoja forma. Nic nie jest wysyłane na serwer YOROI.";
"NSFaceIDUsageDescription" = "YOROI używa Face ID tylko wtedy, gdy włączysz blokadę aplikacji, aby nikt inny nie otworzył twojego dziennika i ważeń.";
"NSHealthShareUsageDescription" = "YOROI odczytuje z aplikacji Zdrowie twoją wagę i skład ciała, aktywność, serce, sen, treningi (trasy, wysiłek, krok, moc, strefy) oraz to, co pijesz i jesz, aby pokazać twoje postępy i gotowość na dziś. Zaawansowane pomiary (chód, alerty serca, dźwięki, składniki odżywcze) tylko wtedy, gdy je włączysz. Nic nie jest wysyłane na serwer YOROI.";
"NSHealthUpdateUsageDescription" = "YOROI zapisuje w aplikacji Zdrowie twoje ważenia i tkankę tłuszczową, treningi, które zapisujesz, wypitą wodę oraz sen wpisany ręcznie. Nic nie jest wysyłane na serwer YOROI.";
"NSLocalNetworkUsageDescription" = "YOROI używa sieci lokalnej, aby synchronizować dane bezpośrednio między twoimi urządzeniami sparowanymi kodem (iPhone, iPad, Mac), gdy aplikacja jest otwarta. Nic nie przechodzi przez internet ani przez serwer YOROI.";
"NSLocationWhenInUseUsageDescription" = "YOROI używa twojej lokalizacji tylko wtedy, gdy o to poprosisz w treningu, aby wpisać nazwę miejsca, na przykład twojej siłowni i miasta. Nigdy w tle i nic nie jest wysyłane na serwer YOROI.";
"NSMicrophoneUsageDescription" = "YOROI używa mikrofonu do dźwięku filmów nagrywanych w dzienniku treningowym oraz do notatek głosowych w karcie partnera sparingowego. Na przykład nagranie techniki z objaśnieniami twojego trenera. Nic nie jest wysyłane na serwer YOROI.";
"NSPhotoLibraryAddUsageDescription" = "YOROI zapisuje w twojej bibliotece zdjęć karty do udostępnienia, które tworzysz, tylko wtedy, gdy o to poprosisz. Na przykład kartę rekordu lub porównanie przed i po. Nic nie jest wysyłane na serwer YOROI.";
"NSPhotoLibraryUsageDescription" = "YOROI otwiera twoją bibliotekę zdjęć tylko wtedy, gdy wybierasz obraz lub film: zdjęcie profilowe, zdjęcia postępów, zdjęcia z wagi, film do dziennika, zdjęcia partnera lub logo klubu. Na przykład import filmu z ostatniego sparingu. Nic nie jest wysyłane na serwer YOROI.";
"NSRemindersFullAccessUsageDescription" = "YOROI nie odczytuje ani nie tworzy przypomnień w aplikacji Przypomnienia i nie prosi o ten dostęp. Twoje przypomnienia, na przykład o pójściu spać, przychodzą jako powiadomienia YOROI.";
"NSRemindersUsageDescription" = "YOROI nie odczytuje ani nie tworzy przypomnień w aplikacji Przypomnienia i nie prosi o ten dostęp. Twoje przypomnienia, na przykład o pójściu spać, przychodzą jako powiadomienia YOROI.";
