/* YOROI : textes système en el. Source : Info.plist (français). */
"CFBundleDisplayName" = "Yoroi";
"NSCalendarsFullAccessUsageDescription" = "Το YOROI προσθέτει έναν αγώνα στο ημερολόγιό σου όταν το ζητάς, για παράδειγμα το επόμενο τουρνουά σου με υπενθύμιση την προηγούμενη μέρα. Εσύ επιβεβαιώνεις το συμβάν πριν αποθηκευτεί.";
"NSCalendarsUsageDescription" = "Το YOROI προσθέτει έναν αγώνα στο ημερολόγιό σου όταν το ζητάς, για παράδειγμα το επόμενο τουρνουά σου με υπενθύμιση την προηγούμενη μέρα. Εσύ επιβεβαιώνεις το συμβάν πριν αποθηκευτεί.";
"NSCameraUsageDescription" = "Το YOROI χρησιμοποιεί την κάμερα μόνο όταν το επιλέγεις: η φωτογραφία προφίλ σου, οι φωτογραφίες προόδου σου, η φωτογραφία μιας κάρτας κοινοποίησης, το λογότυπο του συλλόγου σου ή ένα βίντεο τεχνικής για το ημερολόγιό σου. Για παράδειγμα, μια φωτογραφία από μπροστά κάθε μήνα για να βλέπεις πώς αλλάζει η φόρμα σου. Τίποτα δεν στέλνεται σε διακομιστή του YOROI.";
"NSFaceIDUsageDescription" = "Το YOROI χρησιμοποιεί το Face ID μόνο αν ενεργοποιήσεις το κλείδωμα της εφαρμογής, ώστε κανείς άλλος να μην ανοίγει το ημερολόγιό σου και τις ζυγίσεις σου.";
"NSHealthShareUsageDescription" = "Το YOROI διαβάζει από την Υγεία της Apple το βάρος και τη σύσταση σώματός σου, τη δραστηριότητά σου, την καρδιά σου, τον ύπνο σου, τις προπονήσεις σου (διαδρομές, προσπάθεια, διασκελισμό, ισχύ, ζώνες) και ό,τι πίνεις και τρως, για να δείχνει την πρόοδό σου και την ετοιμότητά σου για σήμερα. Οι προχωρημένες μετρήσεις (βάδιση, ειδοποιήσεις καρδιάς, ήχοι, θρεπτικά συστατικά) μόνο αν τις ενεργοποιήσεις. Τίποτα δεν στέλνεται σε διακομιστή του YOROI.";
"NSHealthUpdateUsageDescription" = "Το YOROI αποθηκεύει στην Υγεία της Apple τις ζυγίσεις σου και το σωματικό σου λίπος, τις προπονήσεις που καταγράφεις, το νερό σου και τον ύπνο που καταχωρίζεις χειροκίνητα. Τίποτα δεν στέλνεται σε διακομιστή του YOROI.";
"NSLocalNetworkUsageDescription" = "Το YOROI χρησιμοποιεί το τοπικό δίκτυο για να συγχρονίζει τα δεδομένα σου απευθείας ανάμεσα στις συσκευές σου που έχουν συνδεθεί με κωδικό (iPhone, iPad, Mac), όταν η εφαρμογή είναι ανοιχτή. Τίποτα δεν περνά από το internet ούτε από διακομιστή του YOROI.";
"NSLocationWhenInUseUsageDescription" = "Το YOROI χρησιμοποιεί την τοποθεσία σου μόνο όταν τη ζητάς σε μια προπόνηση, για να γράψει το όνομα του μέρους, για παράδειγμα το γυμναστήριο και την πόλη σου. Ποτέ στο παρασκήνιο, και τίποτα δεν στέλνεται σε διακομιστή του YOROI.";
"NSMicrophoneUsageDescription" = "Το YOROI χρησιμοποιεί το μικρόφωνο για τον ήχο των βίντεο που τραβάς στο ημερολόγιο προπονήσεών σου και για τις φωνητικές σημειώσεις στην καρτέλα ενός παρτενέρ sparring. Για παράδειγμα, να τραβήξεις μια τεχνική με τις εξηγήσεις του προπονητή σου. Τίποτα δεν στέλνεται σε διακομιστή του YOROI.";
"NSPhotoLibraryAddUsageDescription" = "Το YOROI αποθηκεύει στη βιβλιοθήκη φωτογραφιών σου τις κάρτες κοινοποίησης που δημιουργείς, μόνο όταν το ζητάς. Για παράδειγμα, την κάρτα ρεκόρ σου ή τη σύγκριση πριν και μετά. Τίποτα δεν στέλνεται σε διακομιστή του YOROI.";
"NSPhotoLibraryUsageDescription" = "Το YOROI ανοίγει τη βιβλιοθήκη φωτογραφιών σου μόνο όταν επιλέγεις μια εικόνα ή ένα βίντεο: η φωτογραφία προφίλ σου, οι φωτογραφίες προόδου σου, οι φωτογραφίες της ζυγαριάς σου, ένα βίντεο για το ημερολόγιό σου, οι φωτογραφίες ενός παρτενέρ ή το λογότυπο του συλλόγου σου. Για παράδειγμα, να κάνεις εισαγωγή του βίντεο από το τελευταίο σου sparring. Τίποτα δεν στέλνεται σε διακομιστή του YOROI.";
"NSRemindersFullAccessUsageDescription" = "Το YOROI δεν διαβάζει και δεν δημιουργεί υπενθυμίσεις στην εφαρμογή Υπομνήσεις και δεν σου ζητά αυτή την πρόσβαση. Οι υπενθυμίσεις σου, για παράδειγμα αυτή για τον ύπνο, έρχονται ως ειδοποιήσεις του YOROI.";
"NSRemindersUsageDescription" = "Το YOROI δεν διαβάζει και δεν δημιουργεί υπενθυμίσεις στην εφαρμογή Υπομνήσεις και δεν σου ζητά αυτή την πρόσβαση. Οι υπενθυμίσεις σου, για παράδειγμα αυτή για τον ύπνο, έρχονται ως ειδοποιήσεις του YOROI.";
