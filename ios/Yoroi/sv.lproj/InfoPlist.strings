/* YOROI : textes système en sv. Source : Info.plist (français). */
"CFBundleDisplayName" = "Yoroi";
"NSCalendarsFullAccessUsageDescription" = "YOROI lägger till en tävling i din kalender när du ber om det, till exempel din nästa turnering med en påminnelse dagen innan. Du godkänner själv händelsen innan den sparas.";
"NSCalendarsUsageDescription" = "YOROI lägger till en tävling i din kalender när du ber om det, till exempel din nästa turnering med en påminnelse dagen innan. Du godkänner själv händelsen innan den sparas.";
"NSCameraUsageDescription" = "YOROI använder kameran bara när du väljer det: din profilbild, dina progressbilder, bilden till ett delningskort, din klubbs logga eller en teknikvideo till din dagbok. Till exempel en bild framifrån varje månad för att se hur din form utvecklas. Inget skickas till någon YOROI-server.";
"NSFaceIDUsageDescription" = "YOROI använder Face ID bara om du aktiverar applåset, så att ingen annan kan öppna din dagbok och dina vägningar.";
"NSHealthShareUsageDescription" = "YOROI läser från Apple Hälsa din vikt och kroppssammansättning, din aktivitet, ditt hjärta, din sömn, dina pass (rutter, ansträngning, steg, effekt, zoner) och vad du dricker och äter, för att visa dina framsteg och hur redo du är idag. Avancerade mätvärden (gång, hjärtvarningar, ljud, näringsämnen) bara om du aktiverar dem. Inget skickas till någon YOROI-server.";
"NSHealthUpdateUsageDescription" = "YOROI sparar i Apple Hälsa dina vägningar och ditt kroppsfett, passen du loggar, ditt vatten och sömnen du registrerar manuellt. Inget skickas till någon YOROI-server.";
"NSLocalNetworkUsageDescription" = "YOROI använder det lokala nätverket för att synka din data direkt mellan dina enheter som parkopplats med kod (iPhone, iPad, Mac) när appen är öppen. Inget går via internet eller någon YOROI-server.";
"NSLocationWhenInUseUsageDescription" = "YOROI använder din plats bara när du ber om det i ett pass, för att lägga till platsens namn, till exempel ditt gym och din stad. Aldrig i bakgrunden, och inget skickas till någon YOROI-server.";
"NSMicrophoneUsageDescription" = "YOROI använder mikrofonen för ljudet i videor du filmar i din träningsdagbok och för röstanteckningar på en sparringpartners profil. Till exempel för att filma en teknik medan din coach förklarar. Inget skickas till någon YOROI-server.";
"NSPhotoLibraryAddUsageDescription" = "YOROI sparar delningskorten du skapar i ditt bildbibliotek, bara när du ber om det. Till exempel ditt rekordkort eller din före och efter-jämförelse. Inget skickas till någon YOROI-server.";
"NSPhotoLibraryUsageDescription" = "YOROI öppnar ditt bildbibliotek bara när du väljer en bild eller video: din profilbild, dina progressbilder, bilder på din våg, en video till din dagbok, bilder på en partner eller din klubbs logga. Till exempel för att importera videon från din senaste sparring. Inget skickas till någon YOROI-server.";
"NSRemindersFullAccessUsageDescription" = "YOROI läser inte och skapar inte påminnelser i appen Påminnelser, och ber inte om den åtkomsten. Dina påminnelser, till exempel den för läggdags, kommer som YOROI-notiser.";
"NSRemindersUsageDescription" = "YOROI läser inte och skapar inte påminnelser i appen Påminnelser, och ber inte om den åtkomsten. Dina påminnelser, till exempel den för läggdags, kommer som YOROI-notiser.";
