/* YOROI : textes système en nb. Source : Info.plist (français). */
"CFBundleDisplayName" = "Yoroi";
"NSCalendarsFullAccessUsageDescription" = "YOROI legger til en konkurranse i kalenderen din når du ber om det, for eksempel neste turnering med en påminnelse dagen før. Du godkjenner selv hendelsen før den lagres.";
"NSCalendarsUsageDescription" = "YOROI legger til en konkurranse i kalenderen din når du ber om det, for eksempel neste turnering med en påminnelse dagen før. Du godkjenner selv hendelsen før den lagres.";
"NSCameraUsageDescription" = "YOROI bruker kameraet bare når du velger det: profilbildet ditt, fremgangsbildene dine, bildet til et delingskort, klubblogoen din eller en teknikkvideo til dagboken din. For eksempel et bilde forfra hver måned for å se formen endre seg. Ingenting sendes til en YOROI-server.";
"NSFaceIDUsageDescription" = "YOROI bruker Face ID bare hvis du slår på applåsen, slik at ingen andre kan åpne dagboken og veiingene dine.";
"NSHealthShareUsageDescription" = "YOROI leser fra Apple Helse vekten og kroppssammensetningen din, aktiviteten, hjertet, søvnen, øktene dine (ruter, anstrengelse, steglengde, effekt, soner) og det du drikker og spiser, for å vise fremgangen din og dagsformen. Avanserte målinger (gange, hjertevarsler, lydnivå, næringsstoffer) bare hvis du slår dem på. Ingenting sendes til en YOROI-server.";
"NSHealthUpdateUsageDescription" = "YOROI lagrer i Apple Helse veiingene og fettprosenten din, øktene du registrerer, vannet ditt og søvnen du legger inn manuelt. Ingenting sendes til en YOROI-server.";
"NSLocalNetworkUsageDescription" = "YOROI bruker det lokale nettverket til å synkronisere dataene dine direkte mellom enhetene du har paret med kode (iPhone, iPad, Mac), mens appen er åpen. Ingenting går via internett eller en YOROI-server.";
"NSLocationWhenInUseUsageDescription" = "YOROI bruker posisjonen din bare når du ber om det i en økt, for å legge inn navnet på stedet, for eksempel treningssenteret og byen din. Aldri i bakgrunnen, og ingenting sendes til en YOROI-server.";
"NSMicrophoneUsageDescription" = "YOROI bruker mikrofonen til lyden i videoene du filmer i treningsdagboken og til talenotater på profilen til en sparringpartner. For eksempel å filme en teknikk med forklaringene fra coachen din. Ingenting sendes til en YOROI-server.";
"NSPhotoLibraryAddUsageDescription" = "YOROI lagrer delingskortene du lager i bildebiblioteket ditt, bare når du ber om det. For eksempel rekordkortet ditt eller før og etter-sammenligningen. Ingenting sendes til en YOROI-server.";
"NSPhotoLibraryUsageDescription" = "YOROI åpner bildebiblioteket ditt bare når du velger et bilde eller en video: profilbildet ditt, fremgangsbildene dine, bilder av smartvekten din, en video til dagboken, bilder av en partner eller klubblogoen din. For eksempel å importere videoen av den siste sparringen din. Ingenting sendes til en YOROI-server.";
"NSRemindersFullAccessUsageDescription" = "YOROI leser ikke og lager ikke påminnelser i Påminnelser-appen, og ber ikke om denne tilgangen. Påminnelsene dine, for eksempel den for leggetid, kommer som varsler fra YOROI.";
"NSRemindersUsageDescription" = "YOROI leser ikke og lager ikke påminnelser i Påminnelser-appen, og ber ikke om denne tilgangen. Påminnelsene dine, for eksempel den for leggetid, kommer som varsler fra YOROI.";
