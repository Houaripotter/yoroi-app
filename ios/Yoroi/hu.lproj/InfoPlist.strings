/* YOROI : textes système en hu. Source : Info.plist (français). */
"CFBundleDisplayName" = "Yoroi";
"NSCalendarsFullAccessUsageDescription" = "A YOROI felvesz egy versenyt a naptáradba, amikor kéred, például a következő versenyedet egy előző napi emlékeztetővel. Te magad hagyod jóvá az eseményt, mielőtt mentésre kerül.";
"NSCalendarsUsageDescription" = "A YOROI felvesz egy versenyt a naptáradba, amikor kéred, például a következő versenyedet egy előző napi emlékeztetővel. Te magad hagyod jóvá az eseményt, mielőtt mentésre kerül.";
"NSCameraUsageDescription" = "A YOROI csak akkor használja a kamerát, amikor te választod: a profilképedhez, a fejlődési fotóidhoz, egy megosztható kártya fotójához, a klubod logójához vagy egy technikavideóhoz a naplódba. Például havonta egy szemből készült fotó, hogy lásd, hogyan változik a formád. Semmi nem kerül a YOROI szervereire.";
"NSFaceIDUsageDescription" = "A YOROI csak akkor használja a Face ID-t, ha bekapcsolod az app zárolását, hogy rajtad kívül senki ne nyissa meg a naplódat és a méréseidet.";
"NSHealthShareUsageDescription" = "A YOROI az Apple Egészség appból olvassa a testsúlyodat és a testösszetételedet, az aktivitásodat, a szíved adatait, az alvásodat, az edzéseidet (útvonal, erőfeszítés, lépés, teljesítmény, zónák), valamint azt, amit iszol és eszel, hogy megmutassa a fejlődésedet és a napi felkészültségedet. A haladó mérések (járás, szívvel kapcsolatos figyelmeztetések, hangok, tápanyagok) csak akkor, ha bekapcsolod őket. Semmi nem kerül a YOROI szervereire.";
"NSHealthUpdateUsageDescription" = "A YOROI az Apple Egészség appba menti a méréseidet és a testzsírodat, a rögzített edzéseidet, a folyadékbeviteledet és a kézzel megadott alvásodat. Semmi nem kerül a YOROI szervereire.";
"NSLocalNetworkUsageDescription" = "A YOROI a helyi hálózatot használja, hogy közvetlenül szinkronizálja az adataidat a kóddal párosított eszközeid (iPhone, iPad, Mac) között, amikor az app nyitva van. Semmi nem megy át az interneten vagy a YOROI szerverein.";
"NSLocationWhenInUseUsageDescription" = "A YOROI csak akkor használja a helyzetedet, amikor egy edzésnél kéred, hogy beírja a helyszín nevét, például a termedet és a városodat. Soha nem a háttérben, és semmi nem kerül a YOROI szervereire.";
"NSMicrophoneUsageDescription" = "A YOROI a mikrofont az edzésnaplódba felvett videók hangjához és egy sparringpartner adatlapjának hangjegyzeteihez használja. Például egy technika felvétele az edződ magyarázatával. Semmi nem kerül a YOROI szervereire.";
"NSPhotoLibraryAddUsageDescription" = "A YOROI csak akkor menti a fotótáradba a megosztható kártyáidat, amikor kéred. Például a rekordkártyádat vagy az előtte-utána összehasonlításodat. Semmi nem kerül a YOROI szervereire.";
"NSPhotoLibraryUsageDescription" = "A YOROI csak akkor nyitja meg a fotótáradat, amikor képet vagy videót választasz: a profilképedet, a fejlődési fotóidat, a mérleged fotóit, egy videót a naplódba, egy partner fotóit vagy a klubod logóját. Például a legutóbbi sparringod videójának importálása. Semmi nem kerül a YOROI szervereire.";
"NSRemindersFullAccessUsageDescription" = "A YOROI nem olvas és nem hoz létre emlékeztetőket az Emlékeztetők appban, és nem is kér ehhez hozzáférést. Az emlékeztetőid, például a lefekvési, YOROI-értesítésként érkeznek.";
"NSRemindersUsageDescription" = "A YOROI nem olvas és nem hoz létre emlékeztetőket az Emlékeztetők appban, és nem is kér ehhez hozzáférést. Az emlékeztetőid, például a lefekvési, YOROI-értesítésként érkeznek.";
