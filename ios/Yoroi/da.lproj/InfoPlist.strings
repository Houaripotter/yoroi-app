/* YOROI : textes système en da. Source : Info.plist (français). */
"CFBundleDisplayName" = "Yoroi";
"NSCalendarsFullAccessUsageDescription" = "YOROI tilføjer et stævne til din kalender, når du beder om det, for eksempel din næste turnering med en påmindelse dagen før. Du godkender selv begivenheden, før den bliver gemt.";
"NSCalendarsUsageDescription" = "YOROI tilføjer et stævne til din kalender, når du beder om det, for eksempel din næste turnering med en påmindelse dagen før. Du godkender selv begivenheden, før den bliver gemt.";
"NSCameraUsageDescription" = "YOROI bruger kun kameraet, når du selv vælger det: dit profilbillede, dine fremgangsbilleder, billedet til et delingskort, din klubs logo eller en teknikvideo til din dagbog. For eksempel et billede forfra hver måned, så du kan se din form udvikle sig. Intet sendes til en YOROI-server.";
"NSFaceIDUsageDescription" = "YOROI bruger kun Face ID, hvis du slår applåsen til, så ingen andre kan åbne din dagbog og dine vejninger.";
"NSHealthShareUsageDescription" = "YOROI læser din vægt og kropssammensætning, din aktivitet, dit hjerte, din søvn, dine træninger (ruter, indsats, skridtfrekvens, kraft, zoner) og hvad du drikker og spiser fra Apple Sundhed for at vise din fremgang og din parathed i dag. De avancerede målinger (gang, hjerteadvarsler, lydniveauer, næringsstoffer) kun hvis du slår dem til. Intet sendes til en YOROI-server.";
"NSHealthUpdateUsageDescription" = "YOROI gemmer dine vejninger og din fedtprocent, de træninger du registrerer, dit vand og den søvn du indtaster manuelt i Apple Sundhed. Intet sendes til en YOROI-server.";
"NSLocalNetworkUsageDescription" = "YOROI bruger det lokale netværk til at synkronisere dine data direkte mellem dine enheder, der er parret med en kode (iPhone, iPad, Mac), mens appen er åben. Intet går via internettet eller en YOROI-server.";
"NSLocationWhenInUseUsageDescription" = "YOROI bruger kun din placering, når du beder om det i en træning, for at tilføje navnet på stedet, for eksempel dit fitnesscenter og din by. Aldrig i baggrunden, og intet sendes til en YOROI-server.";
"NSMicrophoneUsageDescription" = "YOROI bruger mikrofonen til lyden i de videoer, du filmer i din træningsdagbog, og til stemmenoter på en sparringmakkers profil. For eksempel at filme en teknik med din coachs forklaringer. Intet sendes til en YOROI-server.";
"NSPhotoLibraryAddUsageDescription" = "YOROI gemmer de delingskort, du laver, i dit fotobibliotek, kun når du beder om det. For eksempel dit rekordkort eller din før og efter-sammenligning. Intet sendes til en YOROI-server.";
"NSPhotoLibraryUsageDescription" = "YOROI åbner kun dit fotobibliotek, når du vælger et billede eller en video: dit profilbillede, dine fremgangsbilleder, billeder af din badevægt, en video til din dagbog, billeder af en makker eller din klubs logo. For eksempel at importere videoen af din seneste sparring. Intet sendes til en YOROI-server.";
"NSRemindersFullAccessUsageDescription" = "YOROI læser ikke og opretter ikke påmindelser i din Påmindelser-app og beder dig ikke om denne adgang. Dine påmindelser, for eksempel sengetidspåmindelsen, kommer som YOROI-notifikationer.";
"NSRemindersUsageDescription" = "YOROI læser ikke og opretter ikke påmindelser i din Påmindelser-app og beder dig ikke om denne adgang. Dine påmindelser, for eksempel sengetidspåmindelsen, kommer som YOROI-notifikationer.";
