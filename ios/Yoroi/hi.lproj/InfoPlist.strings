"CFBundleDisplayName" = "Yoroi";
"NSCalendarsFullAccessUsageDescription" = "आपके कहने पर YOROI आपके कैलेंडर में एक प्रतियोगिता जोड़ता है, जैसे आपका अगला टूर्नामेंट, एक दिन पहले रिमाइंडर के साथ। इवेंट सेव होने से पहले आप खुद उसकी पुष्टि करते हैं।";
"NSCalendarsUsageDescription" = "आपके कहने पर YOROI आपके कैलेंडर में एक प्रतियोगिता जोड़ता है, जैसे आपका अगला टूर्नामेंट, एक दिन पहले रिमाइंडर के साथ। इवेंट सेव होने से पहले आप खुद उसकी पुष्टि करते हैं।";
"NSCameraUsageDescription" = "YOROI कैमरा सिर्फ़ तभी इस्तेमाल करता है जब आप चुनते हैं: आपकी प्रोफ़ाइल फ़ोटो, आपकी प्रगति की फ़ोटो, शेयर कार्ड की फ़ोटो, आपके क्लब का लोगो या आपके लॉग के लिए किसी तकनीक का वीडियो। उदाहरण के लिए, हर महीने सामने से एक फ़ोटो, ताकि आप अपनी फ़ॉर्म में बदलाव देख सकें। YOROI के किसी सर्वर पर कुछ नहीं भेजा जाता।";
"NSFaceIDUsageDescription" = "YOROI Face ID सिर्फ़ तभी इस्तेमाल करता है जब आप ऐप लॉक चालू करते हैं, ताकि आपका लॉग और आपकी वज़न जांच कोई और न खोल सके।";
"NSHealthShareUsageDescription" = "आपकी प्रगति और आज की तैयारी दिखाने के लिए YOROI Apple Health से आपका वज़न और बॉडी कंपोज़िशन, आपकी गतिविधि, आपका दिल, आपकी नींद, आपके सेशन (रूट, मेहनत, कदम, पावर, ज़ोन) और आपका खाना-पीना पढ़ता है। एडवांस्ड माप (चलना, दिल के अलर्ट, आवाज़ें, पोषक तत्व) सिर्फ़ तभी, जब आप उन्हें चालू करें। YOROI के किसी सर्वर पर कुछ नहीं भेजा जाता।";
"NSHealthUpdateUsageDescription" = "YOROI Apple Health में आपकी वज़न जांच और बॉडी फ़ैट, आपके दर्ज किए सेशन, आपका पानी और हाथ से डाली गई नींद सेव करता है। YOROI के किसी सर्वर पर कुछ नहीं भेजा जाता।";
"NSLocalNetworkUsageDescription" = "ऐप खुला होने पर YOROI लोकल नेटवर्क से आपका डेटा सीधे कोड से जोड़े गए आपके डिवाइसों (iPhone, iPad, Mac) के बीच सिंक करता है। कुछ भी इंटरनेट या YOROI के किसी सर्वर से होकर नहीं जाता।";
"NSLocationWhenInUseUsageDescription" = "YOROI आपकी लोकेशन सिर्फ़ तभी इस्तेमाल करता है जब आप किसी सेशन में उसे मांगते हैं, ताकि उसमें जगह का नाम लिखा जा सके, जैसे आपका जिम और आपका शहर। बैकग्राउंड में कभी नहीं, और YOROI के किसी सर्वर पर कुछ नहीं भेजा जाता।";
"NSMicrophoneUsageDescription" = "YOROI माइक्रोफ़ोन का इस्तेमाल आपके ट्रेनिंग लॉग में रिकॉर्ड किए वीडियो की आवाज़ और स्पैरिंग पार्टनर के कार्ड पर वॉइस नोट के लिए करता है। उदाहरण के लिए, अपने कोच की समझाइश के साथ किसी तकनीक का वीडियो बनाना। YOROI के किसी सर्वर पर कुछ नहीं भेजा जाता।";
"NSPhotoLibraryAddUsageDescription" = "YOROI आपके बनाए शेयर कार्ड आपकी फ़ोटो लाइब्रेरी में सिर्फ़ तभी सेव करता है जब आप कहते हैं। उदाहरण के लिए, आपका रिकॉर्ड कार्ड या पहले और बाद की तुलना। YOROI के किसी सर्वर पर कुछ नहीं भेजा जाता।";
"NSPhotoLibraryUsageDescription" = "YOROI आपकी फ़ोटो लाइब्रेरी सिर्फ़ तभी खोलता है जब आप कोई तस्वीर या वीडियो चुनते हैं: आपकी प्रोफ़ाइल फ़ोटो, आपकी प्रगति की फ़ोटो, आपके स्केल की फ़ोटो, आपके लॉग के लिए वीडियो, किसी पार्टनर की फ़ोटो या आपके क्लब का लोगो। उदाहरण के लिए, अपने पिछले स्पैरिंग का वीडियो इंपोर्ट करना। YOROI के किसी सर्वर पर कुछ नहीं भेजा जाता।";
"NSRemindersFullAccessUsageDescription" = "YOROI आपके Reminders ऐप में रिमाइंडर न पढ़ता है, न बनाता है, और न ही इसकी अनुमति मांगता है। आपके रिमाइंडर, जैसे सोने का रिमाइंडर, YOROI सूचनाओं के रूप में आते हैं।";
"NSRemindersUsageDescription" = "YOROI आपके Reminders ऐप में रिमाइंडर न पढ़ता है, न बनाता है, और न ही इसकी अनुमति मांगता है। आपके रिमाइंडर, जैसे सोने का रिमाइंडर, YOROI सूचनाओं के रूप में आते हैं।";
