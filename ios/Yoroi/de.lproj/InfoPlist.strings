/* YOROI : textes système en de. Source : Info.plist (français). */
"NSCalendarsFullAccessUsageDescription" = "YOROI trägt einen Wettkampf in deinen Kalender ein, wenn du es möchtest, zum Beispiel dein nächstes Turnier mit einer Erinnerung am Vortag. Du bestätigst den Termin selbst, bevor er gespeichert wird.";
"NSCalendarsUsageDescription" = "YOROI trägt einen Wettkampf in deinen Kalender ein, wenn du es möchtest, zum Beispiel dein nächstes Turnier mit einer Erinnerung am Vortag. Du bestätigst den Termin selbst, bevor er gespeichert wird.";
"NSCameraUsageDescription" = "YOROI nutzt die Kamera nur, wenn du es auswählst: dein Profilfoto, deine Fortschrittsfotos, ein Foto für eine Teilen-Karte, das Logo deines Vereins oder ein Technikvideo für dein Logbuch. Zum Beispiel jeden Monat ein Foto von vorne, um zu sehen, wie sich deine Form verändert. Nichts wird an einen Server von YOROI gesendet.";
"NSFaceIDUsageDescription" = "YOROI nutzt Face ID nur, wenn du die App-Sperre aktivierst, damit niemand sonst dein Logbuch und deine Wiegedaten öffnen kann.";
"NSHealthShareUsageDescription" = "YOROI liest aus Apple Health dein Gewicht und deine Körperzusammensetzung, deine Aktivität, dein Herz, deinen Schlaf, deine Trainings (Strecken, Anstrengung, Schrittfrequenz, Leistung, Zonen) und was du trinkst und isst, um deine Fortschritte und deine Tagesform anzuzeigen. Erweiterte Messwerte (Gehen, Herzwarnungen, Geräuschpegel, Nährstoffe) nur, wenn du sie aktivierst. Nichts wird an einen Server von YOROI gesendet.";
"NSHealthUpdateUsageDescription" = "YOROI speichert in Apple Health deine Wiegedaten und dein Körperfett, die Trainings, die du einträgst, dein Wasser und den Schlaf, den du von Hand eingibst. Nichts wird an einen Server von YOROI gesendet.";
"NSLocalNetworkUsageDescription" = "YOROI nutzt das lokale Netzwerk, um deine Daten mit dem per Code gekoppelten iPad zu synchronisieren, nur solange der Synchronisierungsbildschirm geöffnet ist.";
"NSLocationWhenInUseUsageDescription" = "YOROI nutzt deinen Standort nur, wenn du ihn in einem Training anforderst, um den Namen des Ortes einzutragen, zum Beispiel dein Gym und deine Stadt. Nie im Hintergrund, und nichts wird an einen Server von YOROI gesendet.";
"NSMicrophoneUsageDescription" = "YOROI nutzt das Mikrofon für den Ton der Videos, die du in deinem Trainingslogbuch filmst, und für Sprachnotizen im Profil eines Sparringpartners. Zum Beispiel, um eine Technik mit den Erklärungen deines Coaches zu filmen. Nichts wird an einen Server von YOROI gesendet.";
"NSPhotoLibraryAddUsageDescription" = "YOROI speichert die Teilen-Karten, die du erstellst, in deiner Fotomediathek, nur wenn du es möchtest. Zum Beispiel deine Rekordkarte oder deinen Vorher-Nachher-Vergleich. Nichts wird an einen Server von YOROI gesendet.";
"NSPhotoLibraryUsageDescription" = "YOROI öffnet deine Fotomediathek nur, wenn du ein Bild oder ein Video auswählst: dein Profilfoto, deine Fortschrittsfotos, Fotos deiner Waage, ein Video für dein Logbuch, Fotos eines Partners oder das Logo deines Vereins. Zum Beispiel, um das Video deines letzten Sparrings zu importieren. Nichts wird an einen Server von YOROI gesendet.";
"NSRemindersFullAccessUsageDescription" = "YOROI liest und erstellt keine Erinnerungen in deiner App Erinnerungen und fragt dich nicht nach diesem Zugriff. Deine Erinnerungen, zum Beispiel die zum Schlafengehen, kommen als Mitteilungen von YOROI.";
"NSRemindersUsageDescription" = "YOROI liest und erstellt keine Erinnerungen in deiner App Erinnerungen und fragt dich nicht nach diesem Zugriff. Deine Erinnerungen, zum Beispiel die zum Schlafengehen, kommen als Mitteilungen von YOROI.";
"CFBundleDisplayName" = "Yoroi";
