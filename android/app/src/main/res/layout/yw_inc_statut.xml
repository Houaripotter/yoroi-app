<?xml version="1.0" encoding="utf-8"?>
<!-- L'ecart au rythme prevu : une seule de ces lignes est visible, dans la couleur de ton allure -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
  <TextView android:id="@+id/yw_ecart_allure" style="@style/YwStatut"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:textColor="@color/yw_allure" android:visibility="gone" />
  <TextView android:id="@+id/yw_ecart_dessus" style="@style/YwStatut"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:textColor="@color/yw_dessus" android:visibility="gone" />
  <TextView android:id="@+id/yw_ecart_vite" style="@style/YwStatut"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:textColor="@color/yw_vite" android:visibility="gone" />
  <TextView android:id="@+id/yw_ecart_aucun" style="@style/YwStatut"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:textColor="@color/yw_encre2" android:visibility="gone" />
</FrameLayout>
