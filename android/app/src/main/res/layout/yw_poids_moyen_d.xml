<?xml version="1.0" encoding="utf-8"?>
<!-- Style D (Scenes illustrees, 28 octobre 2026), derive du style A : memes vues et memes id, couleurs pastel -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/yw_d_fond" android:clipToOutline="true"><ImageView android:id="@+id/yw_fond_img" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/yw_d_fond_moyen" android:importantForAccessibility="no" /><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/yw_d_voile_h" android:importantForAccessibility="no" /><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:padding="@dimen/yw_marge">
  <LinearLayout android:layout_width="0dp" android:layout_weight="4" android:layout_height="match_parent" android:orientation="vertical">
    <TextView android:id="@+id/yw_titre" style="@style/YwTitre" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/yw_nom_poids" android:textColor="@color/yw_d_titre" android:textStyle="bold" android:drawableStart="@drawable/yw_d_lanterne" android:drawablePadding="5dp" />
    <TextView android:id="@+id/yw_valeur" style="@style/YwChiffre" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical|start" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="36sp" android:autoSizeStepGranularity="1sp" android:textColor="@color/yw_d_encre" />
    <include layout="@layout/yw_inc_statut_d" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/yw_date" style="@style/YwPetit" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/yw_d_discret" />
  </LinearLayout>
  <LinearLayout android:layout_width="0dp" android:layout_weight="6" android:layout_height="match_parent" android:layout_marginLeft="10dp" android:orientation="vertical">
    <include layout="@layout/yw_inc_graphe_d" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <include layout="@layout/yw_inc_arrivee_d" android:layout_width="match_parent" android:layout_height="wrap_content" />
  </LinearLayout>
</LinearLayout></FrameLayout>
