<?xml version="1.0" encoding="utf-8"?>
<!-- Etat vide commun : le nom du widget et une invitation simple -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/yw_fond"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="@dimen/yw_marge">
  <TextView android:id="@+id/yw_titre" style="@style/YwTitre"
      android:layout_width="match_parent" android:layout_height="wrap_content" />
  <TextView android:id="@+id/yw_message" style="@style/YwTexte"
      android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
      android:gravity="center_vertical" android:maxLines="3" android:textSize="14sp"
      android:textColor="@color/yw_encre" android:text="@string/yw_vide" />
</LinearLayout>
