<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/yw_fond"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="@dimen/yw_marge">
  <TextView style="@style/YwTitre" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="@string/yw_nom_eau" />
  <ImageView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
      android:layout_marginTop="4dp" android:layout_marginBottom="6dp"
      android:src="@drawable/yw_anneau_apercu" android:scaleType="fitCenter" android:importantForAccessibility="no" />
  <TextView style="@style/YwBouton" android:layout_width="match_parent" android:layout_height="@dimen/yw_bouton_h"
      android:text="@string/yw_plus_verre" />
</LinearLayout>
