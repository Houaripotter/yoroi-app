<?xml version="1.0" encoding="utf-8"?>
<!-- Poids, petit : ton poids, l'ecart colore avec sa fleche, la date de la pesee -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/yw_fond"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="@dimen/yw_marge">
  <TextView android:id="@+id/yw_titre" style="@style/YwTitre"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="@string/yw_nom_poids" />
  <TextView android:id="@+id/yw_valeur" style="@style/YwChiffre"
      android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
      android:gravity="center_vertical|start"
      android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp"
      android:autoSizeMaxTextSize="40sp" android:autoSizeStepGranularity="1sp" />
  <include layout="@layout/yw_inc_statut" android:layout_width="match_parent" android:layout_height="wrap_content" />
  <TextView android:id="@+id/yw_date" style="@style/YwPetit"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="4dp" />
</LinearLayout>
