<?xml version="1.0" encoding="utf-8"?>
<!-- Genere pour le style B (Rouleau et encre), depuis yw_poids_grand.xml (scratchpad/widgets_code/gen_android.py) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/yw_b_fond" android:clipToOutline="true"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="@dimen/yw_marge">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
      <TextView android:id="@+id/yw_titre" style="@style/YwTitre" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/yw_nom_poids" android:textColor="@color/yw_b_titre" android:textStyle="bold" android:fontFamily="serif" android:textSize="14sp" />
      <TextView android:id="@+id/yw_valeur" style="@style/YwChiffre" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical|start" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="38sp" android:autoSizeStepGranularity="1sp" android:textColor="@color/yw_b_encre" android:fontFamily="serif" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
      <include layout="@layout/yw_inc_statut_b" android:layout_width="match_parent" android:layout_height="wrap_content" />
      <TextView android:id="@+id/yw_date" style="@style/YwPetit" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/yw_b_discret" />
    </LinearLayout>
  </LinearLayout>
  <TextView android:id="@+id/yw_phrase" style="@style/YwTexte" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:visibility="gone" android:textColor="@color/yw_b_encre2" />
  <include layout="@layout/yw_inc_graphe_b" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
  <include layout="@layout/yw_inc_arrivee_b" android:layout_width="match_parent" android:layout_height="wrap_content" />
  <LinearLayout android:id="@+id/yw_bas" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal" android:gravity="center_vertical">
    <LinearLayout android:id="@+id/yw_bloc_semaine" android:layout_width="0dp" android:layout_weight="3" android:layout_height="wrap_content" android:orientation="vertical">
      <TextView android:id="@+id/yw_sem_texte" style="@style/YwPetit" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="5dp" android:textColor="@color/yw_b_encre2" />
      <include layout="@layout/yw_inc_points_b" android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>
    <LinearLayout android:id="@+id/yw_bloc_eau" android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" android:layout_marginLeft="12dp" android:orientation="vertical">
      <TextView style="@style/YwPetit" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/yw_nom_eau" android:textColor="@color/yw_b_encre2" />
      <TextView android:id="@+id/yw_eau_valeur" style="@style/YwChiffre" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="17sp" android:textColor="@color/yw_b_encre" android:fontFamily="serif" />
      <TextView android:id="@+id/yw_eau_objectif" style="@style/YwPetit" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/yw_b_discret" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout></FrameLayout>
