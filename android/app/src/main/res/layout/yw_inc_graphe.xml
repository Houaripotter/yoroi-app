<?xml version="1.0" encoding="utf-8"?>
<!-- Courbe 30 jours en calques teintes : rythme prevu en tirets, ta courbe, ton dernier point en couleur d'allure.
     Les teintes viennent des ressources, donc elles suivent le theme clair ou sombre de l'ecran d'accueil. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/yw_graphe"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
  <ImageView android:id="@+id/yw_g_ligne" android:layout_width="match_parent" android:layout_height="match_parent"
      android:scaleType="fitCenter" android:tint="@color/yw_tirets" android:importantForAccessibility="no" />
  <ImageView android:id="@+id/yw_g_courbe" android:layout_width="match_parent" android:layout_height="match_parent"
      android:scaleType="fitCenter" android:tint="@color/yw_indigo" android:importantForAccessibility="no" />
  <ImageView android:id="@+id/yw_g_pt_allure" android:layout_width="match_parent" android:layout_height="match_parent"
      android:scaleType="fitCenter" android:tint="@color/yw_allure" android:visibility="gone" android:importantForAccessibility="no" />
  <ImageView android:id="@+id/yw_g_pt_dessus" android:layout_width="match_parent" android:layout_height="match_parent"
      android:scaleType="fitCenter" android:tint="@color/yw_dessus" android:visibility="gone" android:importantForAccessibility="no" />
  <ImageView android:id="@+id/yw_g_pt_vite" android:layout_width="match_parent" android:layout_height="match_parent"
      android:scaleType="fitCenter" android:tint="@color/yw_vite" android:visibility="gone" android:importantForAccessibility="no" />
  <ImageView android:id="@+id/yw_g_pt_aucun" android:layout_width="match_parent" android:layout_height="match_parent"
      android:scaleType="fitCenter" android:tint="@color/yw_indigo" android:visibility="gone" android:importantForAccessibility="no" />
</FrameLayout>
