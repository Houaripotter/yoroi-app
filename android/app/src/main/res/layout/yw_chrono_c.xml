<?xml version="1.0" encoding="utf-8"?>
<!-- Chrono, style C (Armure laquee) : un grand visuel, le nom de ton dernier reglage et ses rounds en gros. Un appui ouvre le chrono. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/yw_c_fond"
    android:clipToOutline="true">
  <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="5dp"
      android:background="@drawable/yw_c_filet" android:importantForAccessibility="no" />
  <ImageView android:id="@+id/yw_perso" android:layout_width="74dp" android:layout_height="128dp"
      android:layout_gravity="bottom|end" android:layout_marginRight="2dp"
      android:scaleType="fitEnd" android:src="@drawable/yw_c_guerrier" android:importantForAccessibility="no" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
      android:orientation="vertical" android:padding="@dimen/yw_marge">
    <LinearLayout android:id="@+id/yw_chrono_haut" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
      <ImageView android:layout_width="62dp" android:layout_height="62dp" android:scaleType="fitCenter"
          android:src="@drawable/yw_c_gong" android:importantForAccessibility="no" />
      <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/yw_chrono_nom" style="@style/YwChiffre"
        android:layout_width="match_parent" android:layout_height="40dp"
        android:gravity="bottom|start" android:textColor="@color/yw_c_encre"
        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp"
        android:autoSizeMaxTextSize="34sp" android:autoSizeStepGranularity="1sp"
        android:text="@string/yw_nom_chrono" />
    <TextView android:id="@+id/yw_chrono_detail" style="@style/YwChiffre"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:textSize="19sp" android:ellipsize="end"
        android:textColor="@color/yw_c_titre" />
  </LinearLayout>
</FrameLayout>
