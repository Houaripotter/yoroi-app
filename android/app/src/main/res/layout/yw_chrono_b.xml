<?xml version="1.0" encoding="utf-8"?>
<!-- Chrono, style B (Rouleau et encre) : un grand visuel, le nom de ton dernier reglage et ses rounds en gros. Un appui ouvre le chrono. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/yw_b_fond"
    android:clipToOutline="true">

  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
      android:orientation="vertical" android:padding="@dimen/yw_marge">
    <LinearLayout android:id="@+id/yw_chrono_haut" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
      <FrameLayout android:layout_width="66dp" android:layout_height="66dp">
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter"
            android:src="@drawable/yw_b_cercle" android:tint="@color/yw_b_encre" android:importantForAccessibility="no" />
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="9dp" android:scaleType="fitCenter"
            android:src="@drawable/yw_b_combat" android:importantForAccessibility="no" />
      </FrameLayout>
      <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
      <ImageView android:layout_width="32dp" android:layout_height="32dp"
          android:src="@drawable/yw_lecture_vermillon" android:contentDescription="@string/yw_lancer" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/yw_chrono_nom" style="@style/YwChiffre"
        android:layout_width="match_parent" android:layout_height="40dp"
        android:gravity="bottom|start" android:textColor="@color/yw_b_encre" android:fontFamily="serif"
        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp"
        android:autoSizeMaxTextSize="34sp" android:autoSizeStepGranularity="1sp"
        android:text="@string/yw_nom_chrono" />
    <TextView android:id="@+id/yw_chrono_detail" style="@style/YwChiffre"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:textSize="19sp" android:ellipsize="end"
        android:textColor="@color/yw_b_encre" android:fontFamily="serif" />
  </LinearLayout>
</FrameLayout>
