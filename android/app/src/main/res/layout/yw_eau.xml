<?xml version="1.0" encoding="utf-8"?>
<!-- Eau : anneau vers l'objectif, + 1 verre et retrait sans ouvrir l'app -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/yw_fond"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="@dimen/yw_marge">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/yw_titre" style="@style/YwTitre"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:text="@string/yw_nom_eau" />
    <TextView android:id="@+id/yw_eau_valeur_ligne" style="@style/YwChiffre"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="15sp" android:visibility="gone" />
  </LinearLayout>
  <FrameLayout android:id="@+id/yw_anneau" android:layout_width="match_parent" android:layout_height="0dp"
      android:layout_weight="1" android:layout_marginTop="4dp" android:layout_marginBottom="6dp">
    <ImageView android:id="@+id/yw_anneau_piste" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitCenter" android:tint="@color/yw_piste" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/yw_anneau_arc" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitCenter" android:tint="@color/yw_indigo" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:orientation="vertical" android:gravity="center_horizontal">
      <TextView android:id="@+id/yw_eau_valeur" style="@style/YwChiffre"
          android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:textSize="15sp" />
      <TextView android:id="@+id/yw_eau_objectif" style="@style/YwPetit"
          android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:layout_marginTop="1dp" android:textSize="10sp" />
    </LinearLayout>
  </FrameLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/yw_bouton_h"
      android:orientation="horizontal">
    <ImageView android:id="@+id/yw_eau_moins" android:layout_width="@dimen/yw_bouton_h" android:layout_height="match_parent"
        android:background="@drawable/yw_bouton_doux" android:src="@drawable/yw_ic_moins" android:scaleType="center"
        android:contentDescription="@string/yw_retirer_verre" />
    <TextView android:id="@+id/yw_eau_plus" style="@style/YwBouton"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
        android:layout_marginLeft="6dp" android:paddingLeft="6dp" android:paddingRight="6dp"
        android:text="@string/yw_plus_verre" />
  </LinearLayout>
</LinearLayout>
