<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/yw_fond"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="@dimen/yw_marge">
  <TextView style="@style/YwTitre" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="@string/yw_nom_combat" />
  <TextView style="@style/YwTexte" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
      android:gravity="center_vertical" android:textSize="14sp" android:textColor="@color/yw_encre"
      android:text="@string/yw_desc_combat" android:maxLines="3" />
</LinearLayout>
