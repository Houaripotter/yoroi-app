<?xml version="1.0" encoding="utf-8"?>
<!-- Poids, moyen : a gauche le poids et l'ecart, a droite la courbe 30 jours et l'arrivee prevue -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/yw_fond"
    android:clipToOutline="true"
    android:orientation="horizontal"
    android:padding="@dimen/yw_marge">
  <LinearLayout android:layout_width="0dp" android:layout_weight="4" android:layout_height="match_parent"
      android:orientation="vertical">
    <TextView android:id="@+id/yw_titre" style="@style/YwTitre"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/yw_nom_poids" />
    <TextView android:id="@+id/yw_valeur" style="@style/YwChiffre"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center_vertical|start"
        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp"
        android:autoSizeMaxTextSize="36sp" android:autoSizeStepGranularity="1sp" />
    <include layout="@layout/yw_inc_statut" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/yw_date" style="@style/YwPetit"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />
  </LinearLayout>
  <LinearLayout android:layout_width="0dp" android:layout_weight="6" android:layout_height="match_parent"
      android:layout_marginLeft="10dp" android:orientation="vertical">
    <include layout="@layout/yw_inc_graphe" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <include layout="@layout/yw_inc_arrivee" android:layout_width="match_parent" android:layout_height="wrap_content" />
  </LinearLayout>
</LinearLayout>
