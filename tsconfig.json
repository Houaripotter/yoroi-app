{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": [
      "jest",
      "node"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowJs": false
  },
  "exclude": [
    "node_modules",
    "_archive*",
    "_propositions",
    "_verif",
    "_to_delete",
    "_a_supprimer*"
  ],
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
