{
  "expo": {
    "name": "Yoroi",
    "slug": "yoroi",
    "description": "YOROI - Votre compagnon fitness pour le suivi de poids, composition corporelle et entraînements. 100% offline, vos données restent sur votre appareil.",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo d'app/yoroi-logo2.png",
    "scheme": "yoroi",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.houari.yoroi",
      "buildNumber": "38",
      "infoPlist": {
        "NSHealthShareUsageDescription": "YOROI lit dans Apple Santé ton poids et ta composition corporelle, ton activité, ton cœur, ton sommeil, tes séances (tracés, effort, foulée, puissance, zones) et ce que tu bois et manges, pour afficher tes progrès et ta préparation du jour. Les mesures avancées (marche, alertes du cœur, sons, nutriments) seulement si tu les actives. Rien n'est envoyé à un serveur de YOROI.",
        "NSHealthUpdateUsageDescription": "YOROI enregistre dans Apple Santé tes pesées et ta masse grasse, les séances que tu notes, ton eau et le sommeil que tu saisis à la main. Rien n'est envoyé à un serveur de YOROI.",
        "NSSupportsLiveActivities": true,
        "NSCalendarsUsageDescription": "YOROI ajoute une compétition à ton calendrier quand tu le demandes, par exemple ton prochain tournoi avec un rappel la veille. Tu valides toi-même l'événement avant qu'il soit enregistré.",
        "NSCalendarsFullAccessUsageDescription": "YOROI ajoute une compétition à ton calendrier quand tu le demandes, par exemple ton prochain tournoi avec un rappel la veille. Tu valides toi-même l'événement avant qu'il soit enregistré.",
        "NSRemindersUsageDescription": "YOROI ne lit pas et ne crée pas de rappels dans ton app Rappels, et ne te demande pas cet accès. Tes rappels, par exemple celui du coucher, arrivent en notifications YOROI.",
        "NSRemindersFullAccessUsageDescription": "YOROI ne lit pas et ne crée pas de rappels dans ton app Rappels, et ne te demande pas cet accès. Tes rappels, par exemple celui du coucher, arrivent en notifications YOROI.",
        "NSFaceIDUsageDescription": "YOROI utilise Face ID seulement si tu actives le verrouillage de l'app, pour que personne d'autre n'ouvre ton journal et tes pesées.",
        "NSLocationWhenInUseUsageDescription": "YOROI utilise ta position seulement quand tu la demandes dans une séance, pour y inscrire le nom du lieu, par exemple ta salle et ta ville. Jamais en arrière-plan, et rien n'est envoyé à un serveur de YOROI.",
        "NSMicrophoneUsageDescription": "YOROI utilise le micro pour le son des vidéos que tu filmes dans ton journal d'entraînement et pour les notes vocales de la fiche d'un partenaire de sparring. Par exemple, filmer une technique avec les explications de ton coach. Rien n'est envoyé à un serveur de YOROI.",
        "NSPhotoLibraryAddUsageDescription": "YOROI enregistre dans ta photothèque les cartes de partage que tu crées, seulement quand tu le demandes. Par exemple, ta carte de record ou ta comparaison avant et après. Rien n'est envoyé à un serveur de YOROI.",
        "LSApplicationQueriesSchemes": [
          "x-apple-health"
        ],
        "NSUbiquitousContainers": {
          "iCloud.com.houari.yoroi": {
            "NSUbiquitousContainerIsDocumentScopePublic": true,
            "NSUbiquitousContainerName": "YOROI",
            "NSUbiquitousContainerSupportedFolderLevels": "None"
          }
        },
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "fr",
          "en",
          "de",
          "nl",
          "es",
          "pt-BR",
          "it"
        ]
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.background-delivery": true,
        "com.apple.security.application-groups": [
          "group.com.houari.yoroi"
        ],
        "com.apple.developer.icloud-container-identifiers": [
          "iCloud.com.houari.yoroi"
        ],
        "com.apple.developer.icloud-services": [
          "CloudDocuments"
        ],
        "com.apple.developer.ubiquity-container-identifiers": [
          "iCloud.com.houari.yoroi"
        ]
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeHealthAndFitness",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhotos",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/logo d'app/yoroi-logo2.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F1EC",
          "image": "./assets/images/splash-yoroi.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "YOROI ouvre ta photothèque seulement quand tu choisis une image ou une vidéo : ta photo de profil, tes photos de progression, les photos de ta balance, une vidéo pour ton journal, les photos d'un partenaire ou le logo de ton club. Par exemple, importer la vidéo de ton dernier sparring. Rien n'est envoyé à un serveur de YOROI.",
          "cameraPermission": "YOROI utilise la caméra seulement quand tu le choisis : ta photo de profil, tes photos de progression, la photo d'une carte de partage, le logo de ton club ou une vidéo de technique pour ton journal. Par exemple, une photo de face chaque mois pour voir ta forme évoluer. Rien n'est envoyé à un serveur de YOROI."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "YOROI utilise ta position seulement quand tu la demandes dans une séance, pour y inscrire le nom du lieu, par exemple ta salle et ta ville. Jamais en arrière-plan, et rien n'est envoyé à un serveur de YOROI.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "YOROI lit dans Apple Santé ton poids et ta composition corporelle, ton activité, ton cœur, ton sommeil, tes séances (tracés, effort, foulée, puissance, zones) et ce que tu bois et manges, pour afficher tes progrès et ta préparation du jour. Les mesures avancées (marche, alertes du cœur, sons, nutriments) seulement si tu les actives. Rien n'est envoyé à un serveur de YOROI.",
          "NSHealthUpdateUsageDescription": "YOROI enregistre dans Apple Santé tes pesées et ta masse grasse, les séances que tu notes, ton eau et le sommeil que tu saisis à la main. Rien n'est envoyé à un serveur de YOROI.",
          "background": true
        }
      ],
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["fr", "en", "de", "nl", "es", "pt-BR", "it"],
            "android": ["fr", "en", "de", "nl", "es", "pt-BR", "it"]
          }
        }
      ],
      [
        "react-native-health-connect",
        {
          "readPermissions": [
            "android.permission.health.READ_STEPS",
            "android.permission.health.READ_WEIGHT",
            "android.permission.health.READ_BODY_FAT",
            "android.permission.health.READ_SLEEP",
            "android.permission.health.READ_HEART_RATE",
            "android.permission.health.READ_HEART_RATE_VARIABILITY",
            "android.permission.health.READ_RESTING_HEART_RATE",
            "android.permission.health.READ_DISTANCE",
            "android.permission.health.READ_TOTAL_CALORIES_BURNED",
            "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
            "android.permission.health.READ_BASAL_METABOLIC_RATE",
            "android.permission.health.READ_HYDRATION",
            "android.permission.health.READ_OXYGEN_SATURATION",
            "android.permission.health.READ_VO2_MAX",
            "android.permission.health.READ_RESPIRATORY_RATE",
            "android.permission.health.READ_BODY_TEMPERATURE",
            "android.permission.health.READ_LEAN_BODY_MASS",
            "android.permission.health.READ_EXERCISE",
            "android.permission.health.READ_HEIGHT",
            "android.permission.health.READ_FLOORS_CLIMBED",
            "android.permission.health.READ_BLOOD_PRESSURE",
            "android.permission.health.READ_BLOOD_GLUCOSE",
            "android.permission.health.READ_NUTRITION",
            "android.permission.health.READ_SPEED",
            "android.permission.health.READ_POWER",
            "android.permission.health.READ_ELEVATION_GAINED",
            "android.permission.health.READ_BODY_WATER_MASS",
            "android.permission.health.READ_BONE_MASS",
            "android.permission.health.READ_WHEELCHAIR_PUSHES",
            "android.permission.health.READ_HEALTH_DATA_HISTORY"
          ],
          "writePermissions": [
            "android.permission.health.WRITE_WEIGHT",
            "android.permission.health.WRITE_BODY_FAT",
            "android.permission.health.WRITE_HYDRATION",
            "android.permission.health.WRITE_SLEEP",
            "android.permission.health.WRITE_EXERCISE"
          ]
        }
      ],
      "expo-audio",
      "expo-asset",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/wizz.mp3"
          ],
          "icon": "./assets/images/notification-icon.png",
          "color": "#2C4A84"
        }
      ],
      [
